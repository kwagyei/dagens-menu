{
  "name": "dagens-menu",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "SITE=bistro astro dev",
    "dev:bistro": "SITE=bistro astro dev",
    "dev:westafrican": "SITE=westafrican astro dev",
    "build": "astro build",
    "build:bistro": "SITE=bistro npm run build",
    "build:westafrican": "SITE=westafrican npm run build",
    "preview": "astro preview",
    "check": "astro check --minimumFailingSeverity warning",
    "test": "vitest run",
    "test:node": "vitest run --project node",
    "test:db": "vitest run --project db",
    "test:watch": "vitest",
    "check:consent": "node scripts/check-no-third-party.mjs",
    "db:migrate:local": "wrangler d1 migrations apply dagens-menu --local --config d1.local.jsonc",
    "seed": "tsx scripts/seed.ts",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.8",
    "tailwindcss": "^4.3.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/vitest-plugin": "1.4.2",
    "@cloudflare/workers-types": "5.20261016.1",
    "@types/node": "^22.20.5",
    "tsx": "4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.0"
  }
}
