{
  "name": "dagens-menu",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "SITE=bistro astro dev",
    "dev:bistro": "SITE=bistro astro dev",
    "dev:westafrican": "SITE=westafrican astro dev",
    "build": "astro build",
    "build:bistro": "SITE=bistro npm run build",
    "build:westafrican": "SITE=westafrican npm run build",
    "preview": "astro preview",
    "check": "astro check --minimumFailingSeverity warning",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:node": "vitest run --project node",
    "test:db": "vitest run --project db",
    "test:e2e": "playwright test --project=gate",
    "test:e2e:edge": "playwright test --project=edge --project=webkit",
    "test:watch": "vitest",
    "check:consent": "node scripts/check-no-third-party.mjs",
    "db:migrate:local": "wrangler d1 migrations apply dagens-menu --local --config d1.local.jsonc",
    "seed": "tsx scripts/seed.ts",
    "admin": "tsx scripts/admin.ts",
    "backup": "tsx scripts/backup.ts",
    "image-variants": "tsx scripts/image-variants.ts",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.4.0",
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.0.3",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.8",
    "tailwindcss": "^4.3.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@cloudflare/vitest-plugin": "1.4.2",
    "@cloudflare/workers-types": "5.20261016.1",
    "@eslint/js": "10.0.1",
    "@jsquash/webp": "1.5.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.5",
    "eslint": "10.13.0",
    "eslint-plugin-astro": "3.2.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.0"
  }
}
