{
  "name": "dagens-menu",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:bistro": "SITE=bistro astro dev",
    "dev:westafrican": "SITE=westafrican astro dev",
    "prebuild": "node scripts/generate-admin-config.mjs",
    "build": "astro build",
    "build:bistro": "SITE=bistro npm run build",
    "build:westafrican": "SITE=westafrican npm run build",
    "preview": "astro preview",
    "deploy:bistro": "SITE=bistro npm run build && npx wrangler pages deploy dist --project-name dagens-menu-bistro",
    "deploy:westafrican": "SITE=westafrican npm run build && npx wrangler pages deploy dist --project-name dagens-menu-westafrican",
    "astro": "astro"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "wrangler": "^4.151.0"
  }
}
