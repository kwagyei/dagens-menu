---
/**
 * The footer: the name at normal size with the owner's description of the restaurant (the
 * settings tagline, shown nowhere else), how to reach the restaurant, today's hours with the whole
 * week behind "Alla öppettider" (a <details>, so it opens without JavaScript), upcoming special
 * days, and the social links as icons. Upcoming special days stay visible, so a holiday closure
 * shows on every page.
 */
import { dayAndMonth, upcomingExceptions } from "../content/hours";
import { needsConsent } from "../content/consent";
import { localized } from "../content/load";
import { getLocale, t, localePath } from "../i18n";
import Squiggle from "./Squiggle.astro";

const settings = Astro.locals.content.settings;
const style = Astro.locals.content.theme.style;
const hours = Astro.locals.content.hours;
const today = Astro.locals.today;
const locale = getLocale(Astro.url);
const altLocale = locale === "sv" ? "en" : "sv";
const altPath = locale === "sv" ? `/en${Astro.url.pathname}` : Astro.url.pathname.replace(/^\/en/, "") || "/";
const siteName = localized(settings.name, locale);
const specialDays = upcomingExceptions(hours, today.date).slice(0, 3);
const range = (h: { open: string; close: string } | null) => (h ? `${h.open}–${h.close}` : t(locale, "hours.closed"));

const dayKeys = ["monday", "tuesday", "wednesday", "thursday", "friday", "saturday", "sunday"] as const;

// Icons for the networks owners use; any other network gets its name as a text link.
const networks: Record<string, { name: string; path: string; stroke?: boolean }> = {
  instagram: {
    name: "Instagram",
    stroke: true,
    path: "M8 3h8a5 5 0 0 1 5 5v8a5 5 0 0 1-5 5H8a5 5 0 0 1-5-5V8a5 5 0 0 1 5-5zm4 5a4 4 0 1 0 0 8 4 4 0 0 0 0-8zm5.3-1.6v.1",
  },
  facebook: {
    name: "Facebook",
    path: "M13.6 21v-7.6h2.6l.4-3h-3V8.5c0-.9.3-1.5 1.6-1.5h1.6V4.3c-.3 0-1.2-.1-2.3-.1-2.3 0-3.9 1.4-3.9 4v2.2H8v3h2.6V21z",
  },
  tiktok: {
    name: "TikTok",
    path: "M16.6 3c.3 2.1 1.6 3.6 3.9 3.8v3.1c-1.5.1-2.8-.4-3.9-1.1v6.1c0 3.4-2.6 5.9-5.9 5.9S4.8 18.3 4.8 15s2.8-6 6.2-5.7v3.2c-1.6-.4-3.1.8-3.1 2.5 0 1.5 1.2 2.7 2.7 2.7 1.6 0 2.7-1.2 2.7-3V3z",
  },
  twitter: {
    name: "X",
    path: "M17.8 3h3.1l-6.8 7.8L22 21h-6.2l-4.9-6.4L5.3 21H2.2l7.3-8.3L2 3h6.4l4.4 5.8zm-1.1 16.2h1.7L7.4 4.7H5.6z",
  },
};
const socials = Object.entries(settings.socialLinks).map(([network, url]) => ({
  url,
  icon: Object.hasOwn(networks, network) ? networks[network] : undefined,
  name: Object.hasOwn(networks, network) ? networks[network].name : network,
}));
---

<script>
  document.getElementById("change-consent")?.addEventListener("click", () => {
    window.dispatchEvent(new Event("open-consent-banner"));
  });
</script>

<footer class="site-footer">
  {style === "modern" && (
    <div class="site-footer__call">
      <Squiggle />
      <p>{t(locale, "footer.call")}</p>
    </div>
  )}
  <div class="site-footer__inner">
    <div class="site-footer__col">
      <p class="site-footer__name">{siteName}</p>
      <p class="site-footer__tagline">{localized(settings.tagline, locale)}</p>
      <address>
        <span>{settings.address}</span>
        <a href={`tel:${settings.phone.replace(/[\s-]/g, "")}`}>{settings.phone}</a>
        <a href={`mailto:${settings.email}`}>{settings.email}</a>
      </address>
    </div>

    <div class="site-footer__col">
      <p class="site-footer__today">
        {t(locale, "hours.today")}: {range(today.hours)}
      </p>
      <details class="site-footer__week">
        <summary>{t(locale, "footer.allHours")}</summary>
        <dl>
          {dayKeys.map((day) => (
            <div>
              <dt>{t(locale, `weekday.${day}` as Parameters<typeof t>[1])}</dt>
              <dd>{range(hours.weekly[day])}</dd>
            </div>
          ))}
        </dl>
      </details>
      {specialDays.length > 0 && (
        <div class="site-footer__special">
          <p>{t(locale, "hours.exception")}</p>
          <ul>
            {specialDays.map((e) => (
              <li>
                <time datetime={e.date}>{dayAndMonth(e.date, locale)}</time>: {localized(e.note, locale)} ({range(e.hours)})
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>

    <div class="site-footer__col">
      {socials.length > 0 && (
        <ul class="site-footer__social">
          {socials.map(({ url, icon, name }) => (
            <li>
              {icon ? (
                <a href={url} target="_blank" rel="noopener noreferrer" aria-label={`${siteName} ${t(locale, "footer.on")} ${name}`}>
                  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    {icon.stroke ? <path d={icon.path} fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /> : <path d={icon.path} fill="currentColor" />}
                  </svg>
                </a>
              ) : (
                <a class="site-footer__social-text" href={url} target="_blank" rel="noopener noreferrer">
                  {name}
                </a>
              )}
            </li>
          ))}
        </ul>
      )}
      <p class="site-footer__links">
        <a href={altPath} hreflang={altLocale} lang={altLocale}>
          {t(altLocale, "site.language")}
        </a>
        <a href={localePath(locale, "/privacy/")}>{t(locale, "nav.privacy")}</a>
        {needsConsent(settings) && (
          <button id="change-consent" type="button">
            {t(locale, "consent.change")}
          </button>
        )}
      </p>
    </div>
  </div>
</footer>
