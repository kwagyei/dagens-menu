---
/** The header on every page but home, where the navigation sits on the hero photo instead. */
import SiteNav from "./SiteNav.astro";
import { localized } from "../content/load";
import { getLocale, localePath } from "../i18n";

const settings = Astro.locals.content.settings;
const locale = getLocale(Astro.url);
---

<header class="site-bar">
  <div class="site-bar__inner">
    <a class="site-bar__name" href={localePath(locale, "/")}>{localized(settings.name, locale)}</a>
    <SiteNav variant="bar" />
  </div>
</header>
