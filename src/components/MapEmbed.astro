---

import { getLocale, t } from "../i18n";

const locale = getLocale(Astro.url);
const settings = Astro.locals.content.settings;
const mapUrl = settings.mapEmbed;
---

{mapUrl && (
  <div>
    <div id="map-placeholder">
      <button
        id="load-map"
        class="btn btn-primary btn-sm"
      >
        {t(locale, "contact.map.load")}
      </button>
    </div>
    <div
      id="map-container"
      class="hidden mt-4 aspect-video w-full overflow-hidden"
      style={`border-radius: var(--radius);`}
    >
    </div>
    <!-- Inert until consent: the consent check ignores <template>, and nothing in it loads. -->
    <template id="map-embed">
      <iframe src={mapUrl} class="w-full h-full" style="border:0;" allowfullscreen loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="Map"></iframe>
    </template>
  </div>
)}

<script>
  import { onConsent } from "./consent";

  function loadMap() {
    const container = document.getElementById("map-container");
    const placeholder = document.getElementById("map-placeholder");
    const embed = document.getElementById("map-embed");
    if (!container || !placeholder || !(embed instanceof HTMLTemplateElement) || container.childElementCount) return;
    container.append(embed.content.cloneNode(true));
    container.classList.remove("hidden");
    placeholder.classList.add("hidden");
  }

  onConsent("load-map", loadMap);
</script>
