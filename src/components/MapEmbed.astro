---
import { getSettings } from "../content/load";
import { getLocale, t } from "../i18n";

const locale = getLocale(Astro.url);
const settings = getSettings();
const mapUrl = settings.mapEmbed;
---

{mapUrl && (
  <div>
    <div id="map-placeholder">
      <button
        id="load-map"
        class="px-4 py-2 text-sm font-medium"
        style={`background-color: var(--color-primary); color: var(--color-surface); border-radius: var(--radius);`}
      >
        {t(locale, "contact.map.load")}
      </button>
    </div>
    <div
      id="map-container"
      class="hidden mt-4 aspect-video w-full overflow-hidden"
      style={`border-radius: var(--radius);`}
    >
    </div>
  </div>
)}

{mapUrl && (
  <script define:vars={{ mapUrl }}>
    function loadMap() {
      const container = document.getElementById("map-container");
      const placeholder = document.getElementById("map-placeholder");
      if (container && placeholder) {
        container.innerHTML = `<iframe src="${mapUrl}" class="w-full h-full" style="border:0;" allowfullscreen loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="Map"></iframe>`;
        container.classList.remove("hidden");
        placeholder.classList.add("hidden");
      }
    }

    // Load automatically if consent already given
    window.addEventListener("consent-changed", (e) => {
      if (e.detail.consent === "accepted") {
        loadMap();
      }
    });

    // Manual button triggers consent banner if no consent yet
    const btn = document.getElementById("load-map");
    btn?.addEventListener("click", () => {
      const match = document.cookie.match(/(?:^|; )consent=([^;]*)/);
      const consent = match ? decodeURIComponent(match[1]) : null;
      if (consent === "accepted") {
        loadMap();
      } else {
        window.dispatchEvent(new Event("open-consent-banner"));
      }
    });
  </script>
)}
