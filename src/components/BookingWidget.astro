---
import { getSettings, getHours, localized } from "../content/load";
import HoursTable from "./HoursTable.astro";
import { getLocale, t } from "../i18n";

const locale = getLocale(Astro.url);
const settings = getSettings();
const hours = getHours();
const provider = settings.booking.provider;
---

{provider === "none" && (
  <div class="card-lifted p-6 md:p-8">
    <h2 class="font-display text-2xl md:text-3xl mb-6" style="color: var(--color-primary);">
      {t(locale, "booking.fallback.title")}
    </h2>
    <div class="space-y-4 mb-8">
      <p>
        <span class="font-display text-sm tracking-widest" style="color: var(--color-text-muted);">{t(locale, "booking.fallback.phone")}:</span><br />
        <a href={`tel:${settings.phone}`} class="text-lg font-heading font-medium underline" style="color: var(--color-primary);">
          {settings.phone}
        </a>
      </p>
      <p>
        <span class="font-display text-sm tracking-widest" style="color: var(--color-text-muted);">{t(locale, "booking.fallback.email")}:</span><br />
        <a href={`mailto:${settings.email}`} class="text-lg font-heading font-medium underline" style="color: var(--color-primary);">
          {settings.email}
        </a>
      </p>
    </div>
    <div class="pt-6" style={`border-top: 1px solid var(--color-border);`}>
      <h3 class="font-display text-xl mb-4" style="color: var(--color-primary);">
        {t(locale, "contact.hours")}
      </h3>
      <HoursTable hours={hours} />
    </div>
  </div>
)}

{provider === "link" && settings.booking.bookingUrl && (
  <a
    href={settings.booking.bookingUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="btn btn-primary"
  >
    {t(locale, "booking.load")} &rarr;
  </a>
)}

{provider === "embed" && settings.booking.embedCode && (
  <div
    id="booking-widget"
    class="card-lifted p-6 md:p-8"
  >
    <div id="booking-placeholder">
      <p class="mb-4 text-sm" style="color: var(--color-text-muted);">
        {t(locale, "consent.message")}
      </p>
      <button
        id="booking-load"
        class="btn btn-primary"
      >
        {t(locale, "booking.load")}
      </button>
    </div>
    <div id="booking-content" class="hidden"></div>
  </div>
)}

{provider === "embed" && settings.booking.embedCode && (
  <script define:vars={{ embedCode: settings.booking.embedCode }}>
    function loadBooking() {
      const content = document.getElementById("booking-content");
      const placeholder = document.getElementById("booking-placeholder");
      if (content && placeholder) {
        content.innerHTML = embedCode;
        content.classList.remove("hidden");
        placeholder.classList.add("hidden");
      }
    }

    // Load immediately if consent already given
    window.addEventListener("consent-changed", (e) => {
      if (e.detail.consent === "accepted") {
        loadBooking();
      }
    });

    // Manual load button (triggers consent banner if no consent yet)
    const loadBtn = document.getElementById("booking-load");
    loadBtn?.addEventListener("click", () => {
      const match = document.cookie.match(/(?:^|; )consent=([^;]*)/);
      const consent = match ? decodeURIComponent(match[1]) : null;
      if (consent === "accepted") {
        loadBooking();
      } else {
        window.dispatchEvent(new Event("open-consent-banner"));
      }
    });
  </script>
)}
