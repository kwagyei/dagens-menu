---
import { formatPrice, localized, type MenuItem } from "../content/load";
import { getLocale, t } from "../i18n";

const menu = Astro.locals.content.menu;
const locale = getLocale(Astro.url);
const soldOutToday = new Set(Astro.locals.today.soldOut);
/** On the menu and not sold out today. */
const onSale = (item: MenuItem) => item.available && !soldOutToday.has(item.id);
// A category with no dishes has nothing to show (an owner may be building it up).
const categories = menu.categories.filter((category) => category.items.length > 0);
---

<!-- Category jump-links — bold pills -->
<nav class="category-nav mb-0" aria-label={locale === "sv" ? "Menykategorier" : "Menu categories"} style="background-color: var(--color-hero-bg); padding: 1.25rem 0;">
  <div class="section-container flex flex-wrap justify-center gap-3">
    {categories.map((category) => (
      <a href={`#cat-${category.id}`} class="category-pill">
        {localized(category.name, locale)}
      </a>
    ))}
  </div>
</nav>

<!-- Menu categories — alternating dark / gold-tinted sections -->
{categories.map((category, catIndex) => {
  const isGold = catIndex % 2 === 1;
  const catName = localized(category.name, locale);
  const featuredItem = category.items.find(item => item.image && onSale(item));
  const regularItems = category.items.filter(item => item !== featuredItem);

  return (
    <section
      class:list={["menu-section relative overflow-hidden", isGold ? "menu-section-gold" : "section-dark"]}
      id={`cat-${category.id}`}
    >
      <!-- Category watermark -->
      <div class="menu-watermark" aria-hidden="true">
        {catName}
      </div>

      <div class="section-container relative py-14 md:py-20" style="z-index: 1;">
        <!-- Category heading with asymmetric gold bar -->
        <div class="mb-10 md:mb-14">
          <h2 class="menu-cat-heading font-display">
            {catName}
          </h2>
          <div class="menu-cat-bar" aria-hidden="true"></div>
        </div>

        <!-- Featured item — large photo + details side by side -->
        {featuredItem && (
          <div class="menu-featured mb-12 md:mb-16">
            <div class="menu-featured-img-wrap">
              <img
                src={featuredItem.image}
                alt={localized(featuredItem.name, locale)}
                class="menu-featured-img"
                loading="lazy"
              />
            </div>
            <div class="menu-featured-details">
              <span class="menu-featured-label font-display">
                {locale === "sv" ? "Utvalda" : "Featured"}
              </span>
              <h3 class="font-display text-2xl md:text-3xl lg:text-4xl mb-3" style={`color: ${isGold ? 'var(--color-primary)' : 'var(--color-hero-text)'};`}>
                {localized(featuredItem.name, locale)}
              </h3>
              <p class="text-sm md:text-base leading-relaxed mb-4" style={`color: ${isGold ? 'var(--color-text-muted)' : 'var(--color-hero-muted)'};`}>
                {localized(featuredItem.description, locale)}
              </p>
              <div class="menu-price-pill">
                {formatPrice(featuredItem.price)}
              </div>
              {featuredItem.tags.length > 0 && (
                <div class="mt-4 flex flex-wrap gap-2">
                  {featuredItem.tags.map((tag) => (
                    <span class="menu-featured-tag font-display">
                      {t(locale, `menu.tag.${tag}` as any)}
                    </span>
                  ))}
                </div>
              )}
            </div>
          </div>
        )}

        <!-- Regular items list -->
        <div class="space-y-0">
          {regularItems.map((item) => (
            <div class:list={["menu-item-row group", { "opacity-40": !onSale(item) }]}>
              <div class="menu-item-row-header">
                <h3 class="font-display text-lg md:text-xl lg:text-2xl" style={`color: ${isGold ? 'var(--color-primary)' : 'var(--color-hero-text)'};`}>
                  {localized(item.name, locale)}
                </h3>
                <span class="menu-item-dots" aria-hidden="true"></span>
                <span class="menu-price-badge">
                  {formatPrice(item.price)}
                </span>
              </div>

              <p class="mt-1.5 text-sm leading-relaxed max-w-2xl" style={`color: ${isGold ? 'var(--color-text-muted)' : 'var(--color-hero-muted)'};`}>
                {localized(item.description, locale)}
              </p>

              {(item.tags.length > 0 || item.allergens.length > 0) && (
                <div class="mt-2.5 flex flex-wrap gap-2 items-center">
                  {item.tags.map((tag) => (
                    <span class:list={["menu-tag-pill font-display", isGold ? "menu-tag-pill-light" : ""]}>
                      {t(locale, `menu.tag.${tag}` as any)}
                    </span>
                  ))}
                  {item.allergens.length > 0 && (
                    <span class="text-xs" style={`color: ${isGold ? 'var(--color-text-muted)' : 'var(--color-hero-muted)'}; opacity: 0.7;`}>
                      {t(locale, "menu.allergens")}: {item.allergens.join(", ")}
                    </span>
                  )}
                </div>
              )}

              {!onSale(item) && (
                <p class="mt-2 text-xs font-medium italic" style={`color: ${isGold ? 'var(--color-text-muted)' : 'var(--color-hero-muted)'};`}>
                  {t(locale, item.available ? "menu.soldOutToday" : "menu.unavailable")}
                </p>
              )}
            </div>
          ))}
        </div>
      </div>

      <!-- SVG wave divider between sections -->
      {catIndex < categories.length - 1 && (
        <svg class="menu-section-wave" viewBox="0 0 1440 60" preserveAspectRatio="none" aria-hidden="true">
          <path
            d={catIndex % 2 === 0
              ? "M0,40 C480,80 960,0 1440,40 L1440,60 L0,60 Z"
              : "M0,20 C480,-20 960,60 1440,20 L1440,60 L0,60 Z"
            }
            style={`fill: ${catIndex % 2 === 0 ? 'var(--color-surface-alt)' : 'var(--color-hero-bg)'};`}
          />
        </svg>
      )}
    </section>
  );
})}

<style>
  /* --- Menu section backgrounds --------------------------------- */
  .menu-section-gold {
    background-color: var(--color-surface-alt);
    color: var(--color-text);
  }

  /* --- Category watermark behind section ------------------------ */
  .menu-watermark {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    line-height: 0.85;
    font-size: clamp(5rem, 18vw, 16rem);
    white-space: nowrap;
    pointer-events: none;
    user-select: none;
    z-index: 0;
  }
  .section-dark .menu-watermark {
    color: rgba(255, 255, 255, 0.03);
  }
  .menu-section-gold .menu-watermark {
    color: rgba(0, 0, 0, 0.03);
  }

  /* --- Category heading ----------------------------------------- */
  .menu-cat-heading {
    font-size: clamp(2rem, 5vw, 3.5rem);
    letter-spacing: 0.06em;
  }
  .section-dark .menu-cat-heading {
    color: var(--color-secondary);
  }
  .menu-section-gold .menu-cat-heading {
    color: var(--color-primary);
  }

  /* Asymmetric thick gold bar */
  .menu-cat-bar {
    margin-top: 0.75rem;
    width: 60%;
    max-width: 14rem;
    height: 4px;
    background-color: var(--color-secondary);
    border-radius: 2px;
  }

  /* --- Featured item -------------------------------------------- */
  .menu-featured {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  @media (min-width: 768px) {
    .menu-featured {
      flex-direction: row;
      gap: 2.5rem;
      align-items: center;
    }
  }

  .menu-featured-img-wrap {
    flex-shrink: 0;
    width: 100%;
    max-width: 20rem;
    aspect-ratio: 4 / 3;
    position: relative;
  }
  @media (min-width: 768px) {
    .menu-featured-img-wrap {
      width: 45%;
      max-width: none;
      transform: rotate(-2deg);
    }
  }

  .menu-featured-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--radius);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3), 0 2px 8px rgba(0, 0, 0, 0.15);
  }

  .menu-featured-details {
    flex: 1;
  }

  .menu-featured-label {
    display: inline-block;
    font-size: 0.6875rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    padding: 0.25rem 0.75rem;
    border-radius: 2px;
    margin-bottom: 0.75rem;
    background-color: var(--color-secondary);
    color: #1a1a1a;
  }

  .menu-featured-tag {
    display: inline-flex;
    align-items: center;
    padding: 0.125rem 0.625rem;
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border-radius: 9999px;
  }
  .section-dark .menu-featured-tag {
    border: 1px solid var(--color-secondary);
    color: var(--color-secondary);
  }
  .menu-section-gold .menu-featured-tag {
    border: 1px solid var(--color-primary);
    color: var(--color-primary);
  }

  /* --- Price pill (for featured items) -------------------------- */
  .menu-price-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-size: 1.5rem;
    letter-spacing: 0.04em;
    padding: 0.375rem 1.25rem;
    border-radius: 9999px;
    background-color: var(--color-secondary);
    color: #1a1a1a;
    font-weight: 400;
  }

  /* --- Regular item rows ---------------------------------------- */
  .menu-item-row {
    padding: 1.5rem 0 1.5rem 0.75rem;
    border-left: 3px solid transparent;
    transition: border-left-color 0.2s ease, padding-left 0.2s ease, background-color 0.15s ease;
  }
  .section-dark .menu-item-row {
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  .menu-section-gold .menu-item-row {
    border-bottom: 1px solid var(--color-border);
  }
  .menu-item-row:last-child {
    border-bottom: none;
  }
  .menu-item-row:hover {
    border-left-color: var(--color-secondary);
    padding-left: 1.25rem;
  }
  .section-dark .menu-item-row:hover {
    background-color: rgba(255, 255, 255, 0.03);
  }
  .menu-section-gold .menu-item-row:hover {
    background-color: rgba(0, 0, 0, 0.02);
  }

  .menu-item-row-header {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
  }

  /* Dotted leader — larger dots, secondary color */
  .menu-item-dots {
    flex: 1;
    min-width: 2rem;
    height: 0;
    border-bottom: 2px dotted var(--color-secondary);
    opacity: 0.5;
    margin-bottom: 0.2em;
  }

  /* --- Price badge (for list items) ----------------------------- */
  .menu-price-badge {
    font-family: var(--font-display);
    font-size: 1.375rem;
    letter-spacing: 0.04em;
    white-space: nowrap;
    flex-shrink: 0;
    padding: 0.125rem 0.625rem;
    border-radius: 9999px;
    background-color: var(--color-secondary);
    color: #1a1a1a;
    line-height: 1.3;
  }

  /* --- Tag pills on list items ---------------------------------- */
  .menu-tag-pill {
    display: inline-flex;
    align-items: center;
    padding: 0.125rem 0.5rem;
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border-radius: 9999px;
    border: 1px solid var(--color-secondary);
    color: var(--color-secondary);
  }
  .menu-tag-pill-light {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  /* --- SVG wave between sections -------------------------------- */
  .menu-section-wave {
    position: absolute;
    bottom: -1px;
    left: 0;
    width: 100%;
    height: 30px;
    z-index: 2;
  }
  @media (min-width: 768px) {
    .menu-section-wave {
      height: 50px;
    }
  }
</style>
