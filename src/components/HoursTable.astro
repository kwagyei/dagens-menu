---
import { dayAndMonth, upcomingExceptions } from "../content/hours";
import type { OpeningHours } from "../content/load";
import { getLocale, t } from "../i18n";

interface Props {
  hours: OpeningHours;
}

const { hours } = Astro.props;
const locale = getLocale(Astro.url);
const specialDays = upcomingExceptions(hours, Astro.locals.today.date);

const dayKeys = ["monday", "tuesday", "wednesday", "thursday", "friday", "saturday", "sunday"] as const;
const dayNames: Record<string, Record<string, string>> = {
  monday: { sv: "Måndag", en: "Monday" },
  tuesday: { sv: "Tisdag", en: "Tuesday" },
  wednesday: { sv: "Onsdag", en: "Wednesday" },
  thursday: { sv: "Torsdag", en: "Thursday" },
  friday: { sv: "Fredag", en: "Friday" },
  saturday: { sv: "Lördag", en: "Saturday" },
  sunday: { sv: "Söndag", en: "Sunday" },
};
---

<table class="w-full text-left text-sm">
  <tbody>
    {dayKeys.map((day) => {
      const h = hours.weekly[day];
      return (
        <tr style={`border-bottom: 1px solid var(--color-border);`}>
          <td class="py-2.5 font-medium">{dayNames[day][locale]}</td>
          <td class="py-2.5 text-right" style={!h ? "color: var(--color-text-muted);" : ""}>
            {h ? `${h.open}–${h.close}` : t(locale, "hours.closed")}
          </td>
        </tr>
      );
    })}
  </tbody>
</table>

{specialDays.length > 0 && (
  <div class="mt-5 pt-4" style={`border-top: 1px solid var(--color-border);`}>
    <h3 class="font-heading font-bold text-sm mb-2">{t(locale, "hours.exception")}</h3>
    <ul class="text-sm space-y-1.5" style="color: var(--color-text-muted);">
      {specialDays.map((exc) => (
        <li>
          <time class="font-medium" style="color: var(--color-text);" datetime={exc.date}>{dayAndMonth(exc.date, locale)}</time>
          {" – "}
          {locale === "en" ? exc.note.en : exc.note.sv}
          {exc.hours ? ` (${exc.hours.open}–${exc.hours.close})` : ` (${t(locale, "hours.closed")})`}
        </li>
      ))}
    </ul>
  </div>
)}
