---
// The category form: a name in Swedish and in English.
import type { FieldErrors } from "./forms";
import { t } from "../i18n";

interface Props {
  locale: "sv" | "en";
  csrf: string;
  values: { name_sv: string; name_en: string };
  errors: FieldErrors;
  rowVersion?: number;
  submitLabel: string;
  cancelHref: string;
}

const { locale, csrf, values, errors, rowVersion, submitLabel, cancelHref } = Astro.props;
const label = { name_sv: "admin.category.nameSv", name_en: "admin.category.nameEn" } as const;
const errorList = Object.entries(errors).filter(([, m]) => m);
---

<form method="post" class="space-y-5" novalidate>
  {errorList.length > 0 && (
    <div class="admin-message" role="alert">
      <p class="font-semibold">{t(locale, "admin.form.errorsTitle")}</p>
      <ul class="list-disc pl-5 mt-1">
        {errorList.map(([name, message]) => <li><a href={`#${name}`}>{t(locale, label[name as keyof typeof label])}: {message}</a></li>)}
      </ul>
    </div>
  )}
  <input type="hidden" name="csrf" value={csrf} />
  {rowVersion !== undefined && <input type="hidden" name="row_version" value={rowVersion} />}
  {(["name_sv", "name_en"] as const).map((name) => (
    <div class="space-y-1">
      <label class="font-medium block" for={name}>{t(locale, label[name])}</label>
      <input class="admin-input" id={name} name={name} value={values[name]} maxlength="200" aria-invalid={errors[name] ? "true" : undefined} aria-describedby={errors[name] ? `${name}-error` : undefined} />
      {errors[name] && <p class="admin-error" id={`${name}-error`}>{errors[name]}</p>}
    </div>
  ))}
  <div class="flex flex-wrap gap-3 pt-2">
    <button class="admin-button" type="submit">{submitLabel}</button>
    <a class="admin-button admin-button-quiet" href={cancelHref}>{t(locale, "admin.item.cancel")}</a>
  </div>
</form>
