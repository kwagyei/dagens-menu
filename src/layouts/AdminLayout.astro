---
// The admin's own layout: plain, fast and phone-first, in the site's colours, with nothing
// from the public site (no consent banner, no JSON-LD, never indexed).
import "../styles/global.css";
import { localized } from "../content/load";
import { getLocale, t } from "../i18n";

interface Props {
  title: string;
  /** Signed in: show the admin's navigation, with sign-out (needs the form token). */
  csrf?: string;
}

const { title, csrf } = Astro.props;
const locale = getLocale(Astro.url);
const session = Astro.locals.session;
const adminPath = (p: string) => (locale === "en" ? `/en/admin${p}` : `/admin${p}`);
const content = Astro.locals.content;
const siteName = localized(content.settings.name, locale);
const theme = content.theme;
const otherLocale = locale === "sv" ? "en" : "sv";
const otherPath = locale === "sv" ? `/en${Astro.url.pathname}` : Astro.url.pathname.replace(/^\/en/, "") || "/";
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} | {siteName} {t(locale, "admin.title")}</title>
    <style
      is:global
      define:vars={{
        "color-primary": theme.colors.primary,
        "color-bg": theme.colors.background,
        "color-surface": theme.colors.surface,
        "color-text": theme.colors.text,
        "color-text-muted": theme.colors.textMuted,
        "color-border": theme.colors.border,
        "color-hero-bg": theme.colors.heroBg,
        "color-hero-text": theme.colors.heroText,
        radius: theme.cornerRadius,
      }}
    >
      /* After a quick action the page returns to the dish just changed: jump, don't glide. */
      html { scroll-behavior: auto; }
      body { background: var(--color-bg); color: var(--color-text); font-family: system-ui, -apple-system, sans-serif; }
      .admin-bar { background: var(--color-hero-bg); color: var(--color-hero-text); }
      .admin-card { background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius); }
      .admin-button { display: inline-flex; align-items: center; justify-content: center; min-height: 3rem; padding: 0 1.25rem; border-radius: var(--radius); background: var(--color-primary); color: #fff; font-weight: 600; font-size: 1.0625rem; border: 0; cursor: pointer; }
      .admin-button[disabled] { opacity: 0.6; cursor: progress; }
      .admin-button-quiet { background: transparent; color: var(--color-text); border: 1px solid var(--color-border); }
      .admin-muted { color: var(--color-text-muted); }
      .admin-message { border-left: 4px solid var(--color-primary); padding: 0.75rem 1rem; background: var(--color-surface); }
      .admin-error { color: #a1260d; font-weight: 600; }
      .admin-input { width: 100%; min-height: 3rem; padding: 0.5rem 0.75rem; border: 1px solid var(--color-border); border-radius: var(--radius); background: #fff; color: #1a1a1a; font-size: 1rem; }
      .admin-input[aria-invalid="true"] { border-color: #a1260d; border-width: 2px; }
      .admin-small-button { min-height: 2.75rem; min-width: 2.75rem; padding: 0 0.75rem; border-radius: var(--radius); border: 1px solid var(--color-border); background: #fff; color: var(--color-text); font-size: 0.9375rem; cursor: pointer; }
      .admin-badge { display: inline-block; padding: 0.125rem 0.5rem; border-radius: 999px; font-size: 0.8125rem; font-weight: 600; background: var(--color-surface); border: 1px solid var(--color-border); }
      :focus-visible { outline: 3px solid var(--color-primary); outline-offset: 2px; }
      a { color: inherit; }
    </style>
  </head>
  <body class="min-h-screen">
    <header class="admin-bar">
      <div class="max-w-2xl mx-auto px-4 py-3 flex items-center justify-between gap-4">
        <span class="font-semibold">{siteName} · {t(locale, "admin.title")}</span>
        <a href={otherPath} hreflang={otherLocale} lang={otherLocale} class="text-sm underline">{otherLocale.toUpperCase()}</a>
      </div>
      {session && csrf && (
        <nav class="max-w-2xl mx-auto px-4 pb-3 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm" aria-label={t(locale, "admin.title")}>
          <span class="w-full text-xs opacity-80">{t(locale, "admin.home.signedInAs")} {session.email}</span>
          <a class="underline" href={adminPath("/")}>{t(locale, "admin.nav.menu")}</a>
          <a class="underline" href={adminPath("/hours/")}>{t(locale, "admin.nav.hours")}</a>
          <a class="underline" href={adminPath("/texts/")}>{t(locale, "admin.nav.texts")}</a>
          <a class="underline" href={adminPath("/history/")}>{t(locale, "admin.nav.history")}</a>
          <a class="underline" href={adminPath("/security/")}>{t(locale, "admin.security.link")}</a>
          <form method="post" action="/admin/logout" class="ml-auto">
            <input type="hidden" name="csrf" value={csrf} />
            <input type="hidden" name="next" value={adminPath("/")} />
            <button type="submit" class="underline">{t(locale, "admin.signOut")}</button>
          </form>
        </nav>
      )}
    </header>
    <main class="max-w-2xl mx-auto px-4 py-8">
      <slot />
    </main>
  </body>
</html>
