---
import "../styles/global.css";
import "../styles/site.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ConsentBanner from "../components/ConsentBanner.astro";
import { needsConsent } from "../content/consent";
import { upcomingExceptions } from "../content/hours";
import { localized } from "../content/load";
import { serializeJsonLd } from "../server/json-ld";
import { ogImage } from "../server/og-image";
import { pageLinks } from "../server/page-links";
import { getLocale, t } from "../i18n";

interface Props {
  title?: string;
  description?: string;
  jsonLd?: Record<string, unknown>;
  /** Leave out the header: the home page puts its navigation on the hero photo. */
  bare?: boolean;
}

const settings = Astro.locals.content.settings;
const hours = Astro.locals.content.hours;
const theme = Astro.locals.content.theme;
const locale = getLocale(Astro.url);
const siteName = localized(settings.name, locale);
const { title = siteName, description = localized(settings.tagline, locale), jsonLd, bare = false } = Astro.props;
// The fonts each look shows above the fold, fetched early so the hero doesn't reflow.
const preloadFonts = theme.style === "classic" ? ["/fonts/HedvigLettersSerif-24pt.woff2"] : ["/fonts/Anton-Regular.woff2"];
const pageTitle = title === siteName ? siteName : `${title} | ${siteName}`;
const links = pageLinks(Astro.url, locale);
// Every page previews with the home page's hero photo: one picture that says "this restaurant".
const homeHero = Astro.locals.content.pages.home.heroImage;
const preview = ogImage(
  Astro.locals.content.images.find((i) => i.ref === homeHero),
  Astro.url.origin,
);

const dayMap: Record<string, string> = {
  monday: "Mo",
  tuesday: "Tu",
  wednesday: "We",
  thursday: "Th",
  friday: "Fr",
  saturday: "Sa",
  sunday: "Su",
};

const openingHours: string[] = [];
for (const [day, h] of Object.entries(hours.weekly)) {
  if (h) openingHours.push(`${dayMap[day]} ${h.open}-${h.close}`);
}

const specialDays = upcomingExceptions(hours, Astro.locals.today.date);

const restaurantJsonLd = {
  "@context": "https://schema.org",
  "@type": "Restaurant",
  name: siteName,
  description,
  address: {
    "@type": "PostalAddress",
    streetAddress: settings.address,
    addressCountry: "SE",
  },
  telephone: settings.phone,
  email: settings.email,
  openingHours,
  // Special days from today on; a closed day is 00:00–00:00, as schema.org prescribes.
  ...(specialDays.length > 0 && {
    specialOpeningHoursSpecification: specialDays.map((e) => ({
      "@type": "OpeningHoursSpecification",
      validFrom: e.date,
      validThrough: e.date,
      opens: e.hours?.open ?? "00:00",
      closes: e.hours?.close ?? "00:00",
    })),
  }),
  servesCuisine: localized(settings.cuisine, locale),
};

const effectiveJsonLd = jsonLd || restaurantJsonLd;
---

<!doctype html>
<html lang={locale} data-style={theme.style}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {preloadFonts.map((href) => (
      <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />
    ))}
    <link rel="canonical" href={links.canonical} />
    <link rel="alternate" hreflang="sv" href={links.sv} />
    <link rel="alternate" hreflang="en" href={links.en} />

    <!-- Open Graph -->
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={locale === "sv" ? "sv_SE" : "en_GB"} />
    <meta property="og:locale:alternate" content={locale === "sv" ? "en_GB" : "sv_SE"} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:url" content={links.canonical} />
    {preview && (
      <>
        <meta property="og:image" content={preview.url} />
        <meta property="og:image:width" content={String(preview.width)} />
        <meta property="og:image:height" content={String(preview.height)} />
        <meta property="og:image:alt" content={siteName} />
      </>
    )}
    <meta name="twitter:card" content={preview ? "summary_large_image" : "summary"} />

    <!-- JSON-LD -->
    <script type="application/ld+json" set:html={serializeJsonLd(effectiveJsonLd)} />
    <style
      define:vars={{
        "color-primary": theme.colors.primary,
        "color-secondary": theme.colors.secondary,
        "color-accent": theme.colors.accent,
        "color-bg": theme.colors.background,
        "color-surface": theme.colors.surface,
        "color-surface-alt": theme.colors.surfaceAlt,
        "color-text": theme.colors.text,
        "color-text-muted": theme.colors.textMuted,
        "color-border": theme.colors.border,
        "color-hero-bg": theme.colors.heroBg,
        "color-hero-text": theme.colors.heroText,
        "color-hero-muted": theme.colors.heroMuted,
        "font-heading": theme.fonts.heading,
        "font-display": theme.fonts.display,
        "font-body": theme.fonts.body,
        radius: theme.cornerRadius,
      }}
    ></style>
  </head>
  <body class="site">
    <a href={bare ? "#page-title" : "#main-content"} class="skip-link">
      {t(locale, "nav.skip")}
    </a>

    {!bare && <Header />}

    <main id="main-content">
      <slot />
    </main>

    <Footer />
    {needsConsent(settings) && <ConsentBanner />}
  </body>
</html>
