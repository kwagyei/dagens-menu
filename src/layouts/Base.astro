---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ConsentBanner from "../components/ConsentBanner.astro";
import { localized } from "../content/load";
import { serializeJsonLd } from "../server/json-ld";
import { getLocale } from "../i18n";

interface Props {
  title?: string;
  description?: string;
  jsonLd?: Record<string, unknown>;
}

const settings = Astro.locals.content.settings;
const hours = Astro.locals.content.hours;
const theme = Astro.locals.content.theme;
const locale = getLocale(Astro.url);
const siteName = localized(settings.name, locale);
const { title = siteName, description = localized(settings.tagline, locale), jsonLd } =
  Astro.props;
const pageTitle = title === siteName ? siteName : `${title} | ${siteName}`;
const altLocale = locale === "sv" ? "en" : "sv";
// One URL per page: /menu and /menu/ both render, the trailing-slash form is canonical.
const canonicalPath = Astro.url.pathname.endsWith("/") ? Astro.url.pathname : `${Astro.url.pathname}/`;
const altPath = locale === "sv" ? `/en${Astro.url.pathname}` : Astro.url.pathname.replace(/^\/en/, "") || "/";

const dayMap: Record<string, string> = {
  monday: "Mo", tuesday: "Tu", wednesday: "We",
  thursday: "Th", friday: "Fr", saturday: "Sa", sunday: "Su",
};

const openingHours: string[] = [];
for (const [day, h] of Object.entries(hours.weekly)) {
  if (h) openingHours.push(`${dayMap[day]} ${h.open}-${h.close}`);
}

const restaurantJsonLd = {
  "@context": "https://schema.org",
  "@type": "Restaurant",
  name: siteName,
  description,
  address: {
    "@type": "PostalAddress",
    streetAddress: settings.address,
    addressCountry: "SE",
  },
  telephone: settings.phone,
  email: settings.email,
  openingHours,
  servesCuisine: localized(settings.cuisine, locale),
};

const effectiveJsonLd = jsonLd || restaurantJsonLd;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalPath} />
    <link rel="alternate" hreflang={altLocale} href={altPath} />
    <link rel="alternate" hreflang={locale} href={Astro.url.pathname} />

    <!-- Open Graph -->
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={locale === "sv" ? "sv_SE" : "en_GB"} />
    <meta property="og:locale:alternate" content={locale === "sv" ? "en_GB" : "sv_SE"} />
    <meta property="og:site_name" content={siteName} />

    <!-- JSON-LD -->
    <script type="application/ld+json" set:html={serializeJsonLd(effectiveJsonLd)} />

    <style
      define:vars={{
        "color-primary": theme.colors.primary,
        "color-secondary": theme.colors.secondary,
        "color-accent": theme.colors.accent,
        "color-bg": theme.colors.background,
        "color-surface": theme.colors.surface,
        "color-surface-alt": theme.colors.surfaceAlt,
        "color-text": theme.colors.text,
        "color-text-muted": theme.colors.textMuted,
        "color-border": theme.colors.border,
        "color-hero-bg": theme.colors.heroBg,
        "color-hero-text": theme.colors.heroText,
        "color-hero-muted": theme.colors.heroMuted,
        "font-heading": theme.fonts.heading,
        "font-display": theme.fonts.display,
        "font-body": theme.fonts.body,
        "radius": theme.cornerRadius,
      }}
    >
    </style>
  </head>
  <body
    class="min-h-screen flex flex-col"
    style={`background-color: var(--color-bg); color: var(--color-text); font-family: var(--font-body);`}
  >
    <a href="#main-content" class="skip-link">
      {locale === "sv" ? "Hoppa till innehållet" : "Skip to content"}
    </a>

    <Header />

    <main id="main-content" class="flex-1">
      <slot />
    </main>

    <Footer />
    <ConsentBanner />
  </body>
</html>
