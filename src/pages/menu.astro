---
import Base from "../layouts/Base.astro";
import BookingCta from "../components/BookingCta.astro";
import MenuList from "../components/MenuList.astro";
import PageHero from "../components/PageHero.astro";
import { localized } from "../content/load";
import { getLocale, t } from "../i18n";

const locale = getLocale(Astro.url);
const menu = Astro.locals.content.menu;
const settings = Astro.locals.content.settings;
const siteName = localized(settings.name, locale);
const menuTitle = t(locale, "nav.menu");
const soldOutToday = new Set(Astro.locals.today.soldOut);

const menuJsonLd = {
  "@context": "https://schema.org",
  "@type": "Menu",
  name: `${siteName} ${menuTitle}`,
  hasMenuSection: menu.categories.filter((cat) => cat.items.some((item) => item.available)).map((cat) => ({
    "@type": "MenuSection",
    name: localized(cat.name, locale),
    hasMenuItem: cat.items
      .filter((item) => item.available)
      .map((item) => ({
        "@type": "MenuItem",
        name: localized(item.name, locale),
        description: localized(item.description, locale),
        offers: {
          "@type": "Offer",
          price: (item.price / 100).toFixed(2),
          priceCurrency: "SEK",
          availability: soldOutToday.has(item.id) ? "https://schema.org/SoldOut" : "https://schema.org/InStock",
        },
      })),
  })),
};
---

<Base title={menuTitle} jsonLd={menuJsonLd}>
  <PageHero title={menuTitle} intro={t(locale, "menu.intro")} />
  <MenuList />
  <BookingCta />
</Base>
