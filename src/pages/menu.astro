---
import Base from "../layouts/Base.astro";
import MenuList from "../components/MenuList.astro";
import { getMenu, getSettings, getPages, localized } from "../content/load";
import { getLocale, t, localePath } from "../i18n";

const locale = getLocale(Astro.url);
const menu = getMenu();
const settings = getSettings();
const pages = getPages();
const siteName = localized(settings.name, locale);
const menuHeroImage = pages.menu?.heroImage;
const menuTitle = t(locale, "nav.menu");

const menuJsonLd = {
  "@context": "https://schema.org",
  "@type": "Menu",
  name: `${siteName} ${menuTitle}`,
  hasMenuSection: menu.categories.map((cat) => ({
    "@type": "MenuSection",
    name: localized(cat.name, locale),
    hasMenuItem: cat.items
      .filter((item) => item.available)
      .map((item) => ({
        "@type": "MenuItem",
        name: localized(item.name, locale),
        description: localized(item.description, locale),
        offers: {
          "@type": "Offer",
          price: (item.price / 100).toFixed(2),
          priceCurrency: "SEK",
        },
      })),
  })),
};

const ctaImage = menu.categories
  .flatMap(c => c.items)
  .find(i => i.image)?.image;
---

<Base title={menuTitle} jsonLd={menuJsonLd}>

  <!-- Menu hero — massive viewport-filling typography -->
  <section class="menu-hero relative overflow-hidden" style="background-color: var(--color-hero-bg);">
    {menuHeroImage && (
      <img
        src={menuHeroImage}
        alt=""
        class="absolute inset-0 w-full h-full object-cover"
        loading="eager"
      />
    )}
    <div class="absolute inset-0" style="background: linear-gradient(to bottom, rgba(0,0,0,0.5) 0%, rgba(0,0,0,0.7) 100%);"></div>

    <div class="relative overflow-hidden" style="z-index: 1;">
      <!-- Massive title — fills viewport width -->
      <div class="menu-hero-title" aria-hidden="true">
        {menuTitle}
      </div>

      <div class="section-container relative py-20 md:py-28" style="z-index: 2;">
        <p class="font-display text-sm md:text-base tracking-[0.2em] mb-3" style="color: var(--color-secondary);">
          {siteName}
        </p>
        <h1 class="sr-only">{menuTitle}</h1>
        <p class="font-heading text-base md:text-lg max-w-md" style="color: var(--color-hero-muted);">
          {localized(settings.tagline, locale)}
        </p>
      </div>
    </div>

    <!-- SVG wave divider at bottom -->
    <svg class="menu-wave-divider" viewBox="0 0 1440 80" preserveAspectRatio="none" aria-hidden="true">
      <path d="M0,60 C360,100 720,0 1440,60 L1440,80 L0,80 Z" style="fill: var(--color-hero-bg);"/>
    </svg>
  </section>

  <!-- Menu content -->
  <MenuList />

  <!-- Bottom CTA — light cream with overlapping food photo -->
  <section class="menu-cta-section relative overflow-hidden" style="background-color: var(--color-bg);">
    <!-- Overlapping photo from above -->
    {ctaImage && (
      <div class="menu-cta-photo-wrapper">
        <img
          src={ctaImage}
          alt=""
          class="menu-cta-photo"
          loading="lazy"
        />
      </div>
    )}

    <div class="section-container relative py-16 md:py-24 text-center" style="z-index: 1;">
      <div class={ctaImage ? "pt-20 md:pt-28" : ""}>
        <h2 class="font-display text-3xl md:text-4xl lg:text-5xl mb-3" style="color: var(--color-primary);">
          {t(locale, "menu.cta" as any)}
        </h2>
        <p class="text-base mb-8 max-w-md mx-auto" style="color: var(--color-text-muted);">
          {localized(settings.tagline, locale)}
        </p>
        <a href={localePath(locale, "/book/")} class="btn-starburst">
          {t(locale, "home.book")}
        </a>
      </div>
    </div>
  </section>

</Base>

<style>
  .menu-hero-title {
    font-family: var(--font-display);
    font-size: clamp(5rem, 18vw, 20rem);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    line-height: 0.85;
    color: var(--color-hero-text);
    text-align: center;
    padding: 2rem 0 0;
    opacity: 0.15;
    white-space: nowrap;
    overflow: hidden;
    pointer-events: none;
    user-select: none;
  }

  .menu-wave-divider {
    position: absolute;
    bottom: -1px;
    left: 0;
    width: 100%;
    height: 40px;
    z-index: 2;
  }
  @media (min-width: 768px) {
    .menu-wave-divider {
      height: 60px;
    }
  }

  .menu-cta-photo-wrapper {
    position: absolute;
    top: -4rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
    width: 14rem;
    height: 14rem;
  }
  @media (min-width: 768px) {
    .menu-cta-photo-wrapper {
      top: -5rem;
      width: 18rem;
      height: 18rem;
    }
  }

  .menu-cta-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
    border: 4px solid var(--color-secondary);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.25);
  }
</style>
