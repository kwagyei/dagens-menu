---
import Base from "../layouts/Base.astro";
import MenuList from "../components/MenuList.astro";
import { getMenu, getSettings, getPages, localized, formatPrice } from "../content/load";
import { getLocale, t, localePath } from "../i18n";

const locale = getLocale(Astro.url);
const menu = getMenu();
const settings = getSettings();
const pages = getPages();
const siteName = localized(settings.name, locale);
const menuHeroImage = pages.menu?.heroImage;

const menuJsonLd = {
  "@context": "https://schema.org",
  "@type": "Menu",
  name: `${siteName} ${t(locale, "nav.menu")}`,
  hasMenuSection: menu.categories.map((cat) => ({
    "@type": "MenuSection",
    name: localized(cat.name, locale),
    hasMenuItem: cat.items
      .filter((item) => item.available)
      .map((item) => ({
        "@type": "MenuItem",
        name: localized(item.name, locale),
        description: localized(item.description, locale),
        offers: {
          "@type": "Offer",
          price: (item.price / 100).toFixed(2),
          priceCurrency: "SEK",
        },
      })),
  })),
};
---

<Base title={t(locale, "nav.menu")} jsonLd={menuJsonLd}>

  <!-- Menu hero — full-bleed image with dark overlay -->
  <section class="relative overflow-hidden" style="background-color: var(--color-hero-bg);">
    {menuHeroImage && (
      <img
        src={menuHeroImage}
        alt=""
        class="absolute inset-0 w-full h-full object-cover"
        loading="eager"
      />
    )}
    <div class="absolute inset-0 img-overlay-dark"></div>

    <div class="ghost-text bottom-0 left-1/2 -translate-x-1/2 translate-y-1/4">
      {t(locale, "nav.menu")}
    </div>

    <div class="section-container relative py-20 md:py-28 lg:py-32" style="z-index: 1;">
      <p class="font-display text-base md:text-lg tracking-widest mb-4" style="color: var(--color-hero-muted);">
        {siteName}
      </p>
      <h1 class="font-display text-5xl md:text-6xl lg:text-7xl mb-4" style="color: var(--color-hero-text);">
        {t(locale, "nav.menu")}
      </h1>
      <div class="flex items-center gap-3" style="max-width: 10rem;">
        <div style="flex:1; height: 2px; background-color: var(--color-secondary); opacity: 0.6;"></div>
        <div style="width: 6px; height: 6px; transform: rotate(45deg); background-color: var(--color-secondary); opacity: 0.6;"></div>
      </div>
      <p class="mt-6 text-base md:text-lg font-heading max-w-lg" style="color: var(--color-hero-muted);">
        {localized(settings.tagline, locale)}
      </p>
    </div>
  </section>

  <!-- Menu content — dark section with grain texture -->
  <section class="section-dark">
    <div class="section-container py-14 md:py-20">
      <MenuList />
    </div>
  </section>

  <!-- Booking CTA — dramatic dark section with starburst -->
  <section class="section-dark relative overflow-hidden" style="border-top: 1px solid rgba(255,255,255,0.08);">
    <div class="ghost-text top-1/2 right-0 translate-x-1/4 -translate-y-1/2" style="font-size: clamp(4rem, 10vw, 10rem);">
      {t(locale, "cta.booknow" as any)}
    </div>
    <div class="section-container py-16 md:py-24 relative flex flex-col md:flex-row items-center justify-center gap-8 md:gap-16" style="z-index: 1;">
      <div class="text-center md:text-left">
        <h2 class="font-display text-3xl md:text-4xl lg:text-5xl mb-3" style="color: var(--color-hero-text);">
          {t(locale, "menu.cta" as any)}
        </h2>
        <p class="text-base max-w-sm" style="color: var(--color-hero-muted);">
          {localized(settings.tagline, locale)}
        </p>
      </div>
      <a href={localePath(locale, "/book/")} class="btn-starburst">
        {t(locale, "home.book")}
      </a>
    </div>
  </section>

</Base>
