---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import { getLocale, t } from "../i18n";

const locale = getLocale(Astro.url);
const settings = Astro.locals.content.settings;
const hasBooking = settings.booking.provider !== "none";
const hasMap = !!settings.mapEmbed;
const hasThirdParty = hasBooking || hasMap;
---

<Base title={t(locale, "privacy.heading")}>
  <PageHero title={t(locale, "privacy.heading")} intro={t(locale, "privacy.intro")} />
  <div class="legal">
    {!hasThirdParty && (
      <p class="card-lifted">{t(locale, "privacy.no-third-party")}</p>
    )}
    {hasBooking && (
      <section>
        <h2>{t(locale, "privacy.booking.heading")}</h2>
        <p>{t(locale, "privacy.booking.text")}</p>
      </section>
    )}
    {hasMap && (
      <section>
        <h2>{t(locale, "privacy.map.heading")}</h2>
        <p>{t(locale, "privacy.map.text")}</p>
      </section>
    )}
    <section>
      <h2>{t(locale, "privacy.cookies.heading")}</h2>
      <p>{t(locale, "privacy.cookies.text")}</p>
    </section>
  </div>
</Base>
