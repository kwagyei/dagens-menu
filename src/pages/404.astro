---
// Shown for any path that isn't a page, in the visitor's language and the site's design.
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import { getLocale, localePath, t } from "../i18n";

const locale = getLocale(Astro.url);
Astro.response.status = 404;
---

<Base title={t(locale, "notFound.heading")}>
  <PageHero title={t(locale, "notFound.heading")} intro={t(locale, "notFound.text")} />
  <p class="page-cta not-found-links">
    <a class="btn btn-primary" href={localePath(locale, "/")}>
      {t(locale, "nav.home")}
    </a>
    <a class="btn btn-secondary" href={localePath(locale, "/menu/")}>
      {t(locale, "nav.menu")}
    </a>
  </p>
</Base>
