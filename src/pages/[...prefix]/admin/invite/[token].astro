---
// Links from before the token moved into the fragment (/admin/invite/<token>, review L8).
// They are refused without a lookup, so no working link ever carries its token in a URL
// that the Worker's request log records. The operator issues a new link instead.
import AdminLayout from "../../../../layouts/AdminLayout.astro";
import { getLocale, t } from "../../../../i18n";

if (Astro.params.prefix !== undefined && Astro.params.prefix !== "en") return new Response(null, { status: 404 });

const locale = getLocale(Astro.url);
Astro.response.status = 410;
---

<AdminLayout title={t(locale, "admin.invite.heading")}>
  <section class="space-y-6">
    <h1 class="text-3xl font-bold">{t(locale, "admin.invite.heading")}</h1>
    <p class="admin-message">{t(locale, "admin.invite.invalid")}</p>
  </section>
</AdminLayout>
