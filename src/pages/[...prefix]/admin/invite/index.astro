---
// The single-use enrolment link from `npm run admin -- invite`: /admin/invite/#<token>.
// The token is in the fragment, which browsers never send, so it can't land in a request log
// (review L8). The page's script reads it, asks /admin/api/invite-check whether it is still
// good, and only then shows the button; the ceremony posts it in the request body.
import AdminLayout from "../../../../layouts/AdminLayout.astro";
import { localized } from "../../../../content/load";
import { getLocale, localePath, t } from "../../../../i18n";

// Serves /admin/... and /en/admin/...; any other prefix is not a page.
if (Astro.params.prefix !== undefined && Astro.params.prefix !== "en") return new Response(null, { status: 404 });

const locale = getLocale(Astro.url);
const siteName = localized(Astro.locals.content.settings.name, locale);
---

<AdminLayout title={t(locale, "admin.invite.heading")}>
  <section class="space-y-6" data-invite>
    <h1 class="text-3xl font-bold">{t(locale, "admin.invite.heading")}</h1>
    <div class="space-y-6" data-invite-valid hidden>
      <p>{t(locale, "admin.invite.lead").replace("{site}", siteName)}</p>
      <p class="admin-muted" data-invite-email></p>
      <button
        class="admin-button w-full sm:w-auto"
        type="button"
        hidden
        data-passkey="enrol"
        data-next={localePath(locale, "/admin/")}
        data-status="status"
        data-working={t(locale, "admin.working")}
        data-cancelled={t(locale, "admin.error.cancelled")}
        data-failed={t(locale, "admin.error.failed")}
        data-already={t(locale, "admin.invite.alreadyHere")}
        data-signin="invite-sign-in"
      >
        {t(locale, "admin.invite.button")}
      </button>
    </div>
    <p class="admin-message" data-invite-invalid hidden>
      {t(locale, "admin.invite.invalid")}
    </p>
    <p class="admin-message" data-needs-js>
      {t(locale, "admin.noScript")}
    </p>
    <p id="status" role="status" aria-live="polite" data-failed={t(locale, "admin.error.failed")}></p>
    <p id="invite-sign-in" hidden>
      <a class="admin-button inline-flex" href={localePath(locale, "/admin/")}>
        {t(locale, "admin.invite.signInInstead")}
      </a>
    </p>
  </section>
</AdminLayout>

<script>
  import "../../../../admin/passkey-client";
</script>
