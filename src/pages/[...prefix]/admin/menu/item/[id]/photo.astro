---
// Choose a dish's photo from the library, or none (plan M6.10c). One plain form of radio
// buttons; saving writes only the photo, so the dish's own form is never made stale by it.
import AdminLayout from "../../../../../../layouts/AdminLayout.astro";
import PhotoPicker from "../../../../../../admin/PhotoPicker.astro";
import { adminPage } from "../../../../../../admin/page";
import { listLibrary } from "../../../../../../db/library";
import { dishPhoto, setDishPhoto } from "../../../../../../db/photo-choice";
import { getMenuItem } from "../../../../../../db/repository";
import { t } from "../../../../../../i18n";

// Serves /admin/... and /en/admin/...; any other prefix is not a page.
if (Astro.params.prefix !== undefined && Astro.params.prefix !== "en") return new Response(null, { status: 404 });

const page = await adminPage(Astro);
if (page instanceof Response) return page;
const { locale, repo } = page;
const id = Astro.params.id ?? "";
const item = await getMenuItem(repo, id);
if (!item) return Astro.redirect(`${page.path("/")}?done=not-found`, 303);
const here = page.path(`/menu/item/${id}/photo/`);

if (Astro.request.method === "POST") {
  const form = await page.postedForm();
  if (!form) return Astro.redirect(`${here}?done=expired`, 303);
  const chosen = String(form.get("image") ?? "");
  const result = await setDishPhoto(repo, id, chosen === "" ? null : chosen);
  return Astro.redirect(`${here}?done=${result.ok ? "saved" : "not-found"}`, 303);
}

const [current, library] = await Promise.all([dishPhoto(repo, id), listLibrary(repo)]);
const photos = library.filter((i) => i.alt);
const done = Astro.url.searchParams.get("done");
const message: Record<string, { text: string; problem: boolean }> = {
  saved: { text: t(locale, "admin.pick.saved"), problem: false },
  "not-found": { text: t(locale, "admin.pick.notFound"), problem: true },
  expired: { text: t(locale, "admin.error.form"), problem: true },
};
const shown = done ? message[done] : undefined;
const heading = t(locale, "admin.dishPhoto.heading").replace("{name}", item.name[locale]);
---

<AdminLayout title={heading} csrf={page.csrf}>
  <section class="space-y-6">
    <a class="admin-target underline" href={page.path(`/menu/item/${id}/`)}>{t(locale, "admin.dishPhoto.back")}</a>
    <h1 class="text-3xl font-bold">{heading}</h1>
    <p class="admin-muted">{t(locale, Astro.locals.content.theme.style === "classic" ? "admin.dishPhoto.leadClassic" : "admin.dishPhoto.leadModern")}</p>
    {shown && (shown.problem ? (
      <p class="admin-message" role="alert" tabindex="-1" autofocus>{shown.text}</p>
    ) : (
      <p class="admin-message" role="status">{shown.text}</p>
    ))}
    {photos.length === 0 && <p class="admin-muted">{t(locale, "admin.pick.noneYet")}</p>}
    <form method="post" class="space-y-4">
      <input type="hidden" name="csrf" value={page.csrf} />
      <PhotoPicker locale={locale} legend={t(locale, "admin.dishPhoto.legend")} photos={photos} current={current ?? null} />
      <button class="admin-button" type="submit">{t(locale, "admin.pick.save")}</button>
    </form>
    <a class="admin-target underline" href={page.path("/photos/new/")}>{t(locale, "admin.pick.upload")}</a>
  </section>
</AdminLayout>
