---
// Delete a dish, after confirming (plan M5.3).
import AdminLayout from "../../../../../../layouts/AdminLayout.astro";
import { adminPage } from "../../../../../../admin/page";
import { deleteMenuItem, getMenuItem } from "../../../../../../db/repository";
import { t } from "../../../../../../i18n";

// Serves /admin/... and /en/admin/...; any other prefix is not a page.
if (Astro.params.prefix !== undefined && Astro.params.prefix !== "en") return new Response(null, { status: 404 });

const page = await adminPage(Astro);
if (page instanceof Response) return page;
const { locale, repo } = page;
const id = Astro.params.id ?? "";

if (Astro.request.method === "POST") {
  if (!(await page.postedForm())) return Astro.redirect(`${page.path("/")}?done=expired`, 303);
  const result = await deleteMenuItem(repo, id);
  return Astro.redirect(`${page.path("/")}?done=${result.ok ? "deleted" : "not-found"}`, 303);
}

const item = await getMenuItem(repo, id);
if (!item) return Astro.redirect(`${page.path("/")}?done=not-found`, 303);
---

<AdminLayout title={t(locale, "admin.item.deleteHeading")} csrf={page.csrf}>
  <section class="space-y-6">
    <h1 class="text-3xl font-bold">{t(locale, "admin.item.deleteHeading")}</h1>
    <p>{t(locale, "admin.item.deleteLead").replace("{name}", item.name[locale])}</p>
    <form method="post" class="flex flex-wrap gap-3">
      <input type="hidden" name="csrf" value={page.csrf} />
      <button class="admin-button" type="submit">
        {t(locale, "admin.item.deleteConfirm")}
      </button>
      <a class="admin-button admin-button-quiet" href={page.path(`/menu/item/${id}/`)}>
        {t(locale, "admin.item.cancel")}
      </a>
    </form>
  </section>
</AdminLayout>
