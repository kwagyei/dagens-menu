---
// Signed out: sign in with a passkey. Signed in: the whole menu (plan M5.1), with the
// sold-out toggle and up/down on every dish. Quick actions post back here and land on the
// same dish (post/redirect/get).
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { adminPage, signInRedirect } from "../../../admin/page";
import { restaurantDay } from "../../../content/hours";
import { formatPrice } from "../../../content/load";
import { adminMenu, type Direction, moveCategory, moveMenuItem } from "../../../db/menu";
import { setSoldOut } from "../../../db/repository";
import { getLocale, localePath, t } from "../../../i18n";

// Serves /admin/... and /en/admin/...; any other prefix is not a page.
if (Astro.params.prefix !== undefined && Astro.params.prefix !== "en") return new Response(null, { status: 404 });

const locale = getLocale(Astro.url);
const home = localePath(locale, "/admin/");

let page = null;
let menu: Awaited<ReturnType<typeof adminMenu>> = [];
let today = "";
if (Astro.locals.session) {
  const found = await adminPage(Astro);
  if (found instanceof Response) return found;
  page = found;

  if (Astro.request.method === "POST") {
    const form = await page.postedForm();
    if (!form) return Astro.redirect(`${home}?done=expired`, 303);
    const id = String(form.get("id") ?? "");
    const raw = form.get("direction");
    const direction: Direction | null = raw === "up" || raw === "down" ? raw : null;
    const action = form.get("action");
    const result =
      action === "sold-out"
        ? await setSoldOut(page.repo, id, form.get("value") === "1")
        : action === "move-item" && direction
          ? await moveMenuItem(page.repo, id, direction)
          : action === "move-category" && direction
            ? await moveCategory(page.repo, id, direction)
            : { ok: false as const, error: "not-found" as const };
    // Name what changed, so its button takes focus again on the next page (no JS needed).
    // No #fragment: browsers skip autofocus when the URL targets an element, and focusing
    // the button scrolls it into view anyway.
    const changed = result.ok ? `?changed=${encodeURIComponent(`${action}:${id}:${direction ?? ""}`)}` : "?done=not-found";
    return Astro.redirect(`${home}${changed}`, 303);
  }

  menu = await adminMenu(page.repo);
  today = restaurantDay(page.repo.now).date;
} else if (Astro.request.method === "POST") {
  // A quick action posted after the session ended: say it wasn't saved (review L1).
  return signInRedirect(Astro);
}

const done = Astro.url.searchParams.get("done");
// After a quick action, focus returns to the control just used (M5.7). A move that reached
// the top or bottom disables that button, so focus goes to the other direction's instead.
const [changedAction, changedId, changedDir] = (Astro.url.searchParams.get("changed") ?? "").split(":");
/** `disabled` is this button's state; `oppositeDisabled` the other direction's. */
const focusMove = (action: string, id: string, dir: "up" | "down", disabled: boolean, oppositeDisabled: boolean) => {
  if (changedAction !== action || changedId !== id || disabled) return false;
  // The button for the direction just used, or this one if that one is now disabled.
  return dir === changedDir || oppositeDisabled;
};
const message: Record<string, string> = {
  saved: t(locale, "admin.menu.saved"),
  added: t(locale, "admin.menu.added"),
  deleted: t(locale, "admin.menu.deleted"),
  "not-found": t(locale, "admin.menu.notFound"),
  "pick-category": t(locale, "admin.menu.pickCategory"),
  "saved-not-featured": t(locale, "admin.menu.savedNotFeatured"),
  "added-not-featured": t(locale, "admin.menu.addedNotFeatured"),
  expired: t(locale, "admin.error.form"),
};
---

<AdminLayout title={page ? t(locale, "admin.menu.heading") : t(locale, "admin.signIn.heading")} csrf={page?.csrf}>
  {page ? (
    <section class="space-y-6">
      <div>
        <h1 class="text-3xl font-bold">{t(locale, "admin.menu.heading")}</h1>
        <p class="admin-muted mt-1">{t(locale, "admin.menu.lead")}</p>
      </div>
      {done && message[done] && <p class="admin-message" role="status">{message[done]}</p>}

      {menu.map((category, ci) => (
        <section class="admin-card p-4 space-y-3" id={`category-${category.id}`} aria-labelledby={`category-title-${category.id}`}>
          <div class="flex flex-wrap items-center justify-between gap-2">
            <h2 class="text-xl font-semibold" id={`category-title-${category.id}`}>{category.name[locale]}</h2>
            <div class="flex flex-wrap gap-2">
              {(["up", "down"] as const).map((dir) => (
                <form method="post">
                  <input type="hidden" name="csrf" value={page.csrf} />
                  <input type="hidden" name="action" value="move-category" />
                  <input type="hidden" name="id" value={category.id} />
                  <input type="hidden" name="direction" value={dir} />
                  <button
                    class="admin-small-button"
                    type="submit"
                    disabled={(dir === "up" && ci === 0) || (dir === "down" && ci === menu.length - 1)}
                    autofocus={focusMove("move-category", category.id, dir, (dir === "up" && ci === 0) || (dir === "down" && ci === menu.length - 1), (dir === "down" && ci === 0) || (dir === "up" && ci === menu.length - 1))}
                    aria-label={`${t(locale, dir === "up" ? "admin.menu.up" : "admin.menu.down")}: ${category.name[locale]}`}
                  >{dir === "up" ? "↑" : "↓"}</button>
                </form>
              ))}
              <a class="admin-small-button inline-flex items-center" href={page.path(`/menu/category/${category.id}/`)}>{t(locale, "admin.menu.renameCategory")}</a>
            </div>
          </div>

          {category.items.length === 0 && <p class="admin-muted">{t(locale, "admin.menu.empty")}</p>}
          <ul class="divide-y" style="border-color: var(--color-border);">
            {category.items.map((item, ii) => {
              const soldOut = item.soldOutOn === today;
              return (
                <li class="py-3 space-y-2" id={`item-${item.id}`}>
                  <div class="flex items-start justify-between gap-3">
                    <div>
                      <p class="font-semibold">{item.name[locale]}</p>
                      <p class="admin-muted">{formatPrice(item.priceOre)}</p>
                      <p class="flex flex-wrap gap-1.5 mt-1">
                        {soldOut && <span class="admin-badge">{t(locale, "admin.menu.isSoldOut")}</span>}
                        {!item.available && <span class="admin-badge">{t(locale, "admin.menu.offMenu")}</span>}
                        {item.featured && <span class="admin-badge">★ {t(locale, "admin.menu.featured")}</span>}
                      </p>
                    </div>
                    <a class="admin-small-button inline-flex items-center shrink-0" href={page.path(`/menu/item/${item.id}/`)}>{t(locale, "admin.menu.edit")}</a>
                  </div>
                  <div class="flex flex-wrap gap-2">
                    <form method="post">
                      <input type="hidden" name="csrf" value={page.csrf} />
                      <input type="hidden" name="action" value="sold-out" />
                      <input type="hidden" name="id" value={item.id} />
                      <input type="hidden" name="value" value={soldOut ? "0" : "1"} />
                      <button class="admin-button" type="submit" autofocus={changedAction === "sold-out" && changedId === item.id} aria-label={`${soldOut ? t(locale, "admin.menu.backOnSale") : t(locale, "admin.menu.soldOut")}: ${item.name[locale]}`}>
                        {soldOut ? t(locale, "admin.menu.backOnSale") : t(locale, "admin.menu.soldOut")}
                      </button>
                    </form>
                    {(["up", "down"] as const).map((dir) => (
                      <form method="post">
                        <input type="hidden" name="csrf" value={page.csrf} />
                        <input type="hidden" name="action" value="move-item" />
                        <input type="hidden" name="id" value={item.id} />
                        <input type="hidden" name="direction" value={dir} />
                        <button
                          class="admin-small-button"
                          type="submit"
                          disabled={(dir === "up" && ii === 0) || (dir === "down" && ii === category.items.length - 1)}
                          autofocus={focusMove("move-item", item.id, dir, (dir === "up" && ii === 0) || (dir === "down" && ii === category.items.length - 1), (dir === "down" && ii === 0) || (dir === "up" && ii === category.items.length - 1))}
                          aria-label={`${t(locale, dir === "up" ? "admin.menu.up" : "admin.menu.down")}: ${item.name[locale]}`}
                        >{dir === "up" ? "↑" : "↓"}</button>
                      </form>
                    ))}
                  </div>
                </li>
              );
            })}
          </ul>
          <a class="admin-button admin-button-quiet" href={page.path(`/menu/new/?category=${category.id}`)}>+ {t(locale, "admin.menu.addDish")}</a>
        </section>
      ))}

      <a class="admin-button" href={page.path("/menu/category/new/")}>+ {t(locale, "admin.menu.addCategory")}</a>
    </section>
  ) : (
    <section class="space-y-6">
      <h1 class="text-3xl font-bold">{t(locale, "admin.signIn.heading")}</h1>
      <p class="admin-muted">{t(locale, "admin.signIn.lead")}</p>
      <button
        class="admin-button w-full sm:w-auto"
        type="button"
        hidden
        data-passkey="login"
        data-next={home}
        data-status="status"
        data-working={t(locale, "admin.working")}
        data-cancelled={t(locale, "admin.error.cancelled")}
        data-failed={t(locale, "admin.error.failed")}
      >{t(locale, "admin.signIn.button")}</button>
      <p class="admin-message" data-needs-js>{t(locale, "admin.noScript")}</p>
      {/* The passkey script replaces this text once the owner tries to sign in. */}
      <p id="status" role="status" aria-live="polite" class:list={[done === "expired" && "admin-message"]}>
        {done === "expired" && t(locale, "admin.signIn.expired")}
      </p>
    </section>
  )}
</AdminLayout>

<script>
  import "../../../admin/passkey-client";
</script>
