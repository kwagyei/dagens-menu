---
// Opening hours (plan M5.4): the normal week, and holidays or special days. Plain forms that
// post back here; errors come back next to the day or field, with the owner's input kept.
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { type ExceptionFormValues, type FieldErrors, parseExceptionForm, parseHoursForm, type WeeklyFormValues } from "../../../admin/forms";
import { adminPage } from "../../../admin/page";
import { WEEKDAYS } from "../../../content/vocabulary";
import { addException, adminHours, removeException, saveWeeklyHours } from "../../../db/hours";
import { t } from "../../../i18n";

// Serves /admin/... and /en/admin/...; any other prefix is not a page.
if (Astro.params.prefix !== undefined && Astro.params.prefix !== "en") return new Response(null, { status: 404 });

const page = await adminPage(Astro);
if (page instanceof Response) return page;
const { locale, repo } = page;
const here = page.path("/hours/");
const current = await adminHours(repo);

let weekly: WeeklyFormValues = {
  days: Object.fromEntries(
    WEEKDAYS.map((d) => [d, { open: current.weekly[d]?.open ?? "", close: current.weekly[d]?.close ?? "", closed: current.weekly[d] === null }]),
  ) as WeeklyFormValues["days"],
};
let weeklyErrors: FieldErrors = {};
let exception: ExceptionFormValues = { date: "", closed: true, open: "", close: "", note_sv: "", note_en: "" };
let exceptionErrors: FieldErrors = {};

if (Astro.request.method === "POST") {
  const form = await page.postedForm();
  if (!form) return Astro.redirect(`${here}?done=expired`, 303);
  const action = form.get("action");
  if (action === "weekly") {
    const parsed = parseHoursForm(form, locale);
    weekly = parsed.values;
    weeklyErrors = parsed.errors;
    if (parsed.weekly) {
      const result = await saveWeeklyHours(repo, parsed.weekly);
      if (result.ok) return Astro.redirect(`${here}?done=saved`, 303);
      weeklyErrors = { monday: t(locale, "admin.error.failed") };
    }
  } else if (action === "add-exception") {
    const parsed = parseExceptionForm(form, locale);
    exception = parsed.values;
    exceptionErrors = parsed.errors;
    if (parsed.exception) {
      const result = await addException(repo, parsed.exception);
      if (result.ok) return Astro.redirect(`${here}?done=added#exceptions`, 303);
      const messages: Record<string, string> = {
        past: t(locale, "admin.hours.past"),
        "too-far": t(locale, "admin.hours.tooFar"),
        duplicate: t(locale, "admin.hours.duplicate"),
      };
      exceptionErrors = { date: messages[result.error] ?? t(locale, "admin.error.failed") };
    }
  } else if (action === "remove-exception") {
    const result = await removeException(repo, String(form.get("date") ?? ""));
    return Astro.redirect(`${here}?done=${result.ok ? "deleted" : "not-found"}#exceptions`, 303);
  }
  Astro.response.status = 422;
}

const done = Astro.url.searchParams.get("done");
const message: Record<string, string> = {
  saved: t(locale, "admin.menu.saved"),
  added: t(locale, "admin.menu.added"),
  deleted: t(locale, "admin.menu.deleted"),
  "not-found": t(locale, "admin.menu.notFound"),
  expired: t(locale, "admin.error.form"),
};
const dateText = (iso: string) =>
  new Intl.DateTimeFormat(locale === "sv" ? "sv-SE" : "en-GB", { weekday: "long", day: "numeric", month: "long", year: "numeric", timeZone: "UTC" }).format(new Date(`${iso}T12:00:00Z`));
---

<AdminLayout title={t(locale, "admin.hours.heading")} csrf={page.csrf}>
  <section class="space-y-8">
    <h1 class="text-3xl font-bold">{t(locale, "admin.hours.heading")}</h1>
    {done && message[done] && <p class="admin-message" role="status">{message[done]}</p>}

    <form method="post" class="admin-card p-4 space-y-4" novalidate>
      <h2 class="text-xl font-semibold">{t(locale, "admin.hours.weekly")}</h2>
      <p class="text-sm admin-muted">{t(locale, "admin.hours.afterMidnight")}</p>
      {Object.keys(weeklyErrors).length > 0 && <p class="admin-message" role="alert">{t(locale, "admin.form.errorsTitle")}</p>}
      <input type="hidden" name="csrf" value={page.csrf} />
      <input type="hidden" name="action" value="weekly" />
      {WEEKDAYS.map((day) => (
        <fieldset class="space-y-2 border-t pt-3" style="border-color: var(--color-border);" aria-describedby={weeklyErrors[day] ? `${day}-error` : undefined}>
          <legend class="font-semibold">{t(locale, `weekday.${day}`)}</legend>
          <label class="flex items-center gap-2 min-h-11"><input type="checkbox" name={`${day}_closed`} checked={weekly.days[day].closed} class="h-5 w-5" /> {t(locale, "admin.hours.closed")}</label>
          <div class="grid grid-cols-2 gap-3">
            <label class="space-y-1"><span class="text-sm block">{t(locale, "admin.hours.opens")}</span>
              <input class="admin-input" type="time" name={`${day}_open`} value={weekly.days[day].open} aria-invalid={weeklyErrors[day] ? "true" : undefined} /></label>
            <label class="space-y-1"><span class="text-sm block">{t(locale, "admin.hours.closes")}</span>
              <input class="admin-input" type="time" name={`${day}_close`} value={weekly.days[day].close} aria-invalid={weeklyErrors[day] ? "true" : undefined} /></label>
          </div>
          {weeklyErrors[day] && <p class="admin-error" id={`${day}-error`}>{weeklyErrors[day]}</p>}
        </fieldset>
      ))}
      <button class="admin-button" type="submit">{t(locale, "admin.hours.save")}</button>
    </form>

    <section class="admin-card p-4 space-y-4" id="exceptions" aria-labelledby="exceptions-title">
      <h2 class="text-xl font-semibold" id="exceptions-title">{t(locale, "admin.hours.exceptions")}</h2>
      <p class="text-sm admin-muted">{t(locale, "admin.hours.exceptionsLead")}</p>
      {current.exceptions.length === 0 && <p class="admin-muted">{t(locale, "admin.hours.noExceptions")}</p>}
      <ul class="space-y-2">
        {current.exceptions.map((e) => (
          <li class="flex items-center justify-between gap-3 py-2 border-b" style="border-color: var(--color-border);">
            <div>
              <p class="font-medium">{dateText(e.date)}</p>
              <p class="text-sm admin-muted">{e.hours ? `${e.hours.open}–${e.hours.close}` : t(locale, "admin.hours.closedAllDay")} · {e.note[locale]}</p>
            </div>
            <form method="post">
              <input type="hidden" name="csrf" value={page.csrf} />
              <input type="hidden" name="action" value="remove-exception" />
              <input type="hidden" name="date" value={e.date} />
              <button class="admin-small-button" type="submit" aria-label={`${t(locale, "admin.hours.remove")}: ${dateText(e.date)}`}>{t(locale, "admin.hours.remove")}</button>
            </form>
          </li>
        ))}
      </ul>

      <form method="post" class="space-y-3 pt-2" novalidate>
        <h3 class="font-semibold">{t(locale, "admin.hours.addException")}</h3>
        {Object.keys(exceptionErrors).length > 0 && <p class="admin-message" role="alert">{t(locale, "admin.form.errorsTitle")}</p>}
        <input type="hidden" name="csrf" value={page.csrf} />
        <input type="hidden" name="action" value="add-exception" />
        <label class="block space-y-1"><span class="font-medium block">{t(locale, "admin.hours.date")}</span>
          <input class="admin-input" type="date" name="date" id="date" value={exception.date} aria-invalid={exceptionErrors.date ? "true" : undefined} aria-describedby={exceptionErrors.date ? "date-error" : undefined} /></label>
        {exceptionErrors.date && <p class="admin-error" id="date-error">{exceptionErrors.date}</p>}
        <label class="flex items-center gap-2 min-h-11"><input type="checkbox" name="closed" checked={exception.closed} class="h-5 w-5" /> {t(locale, "admin.hours.closedAllDay")}</label>
        <div class="grid grid-cols-2 gap-3">
          <label class="space-y-1"><span class="text-sm block">{t(locale, "admin.hours.opens")}</span>
            <input class="admin-input" type="time" name="exception_open" value={exception.open} /></label>
          <label class="space-y-1"><span class="text-sm block">{t(locale, "admin.hours.closes")}</span>
            <input class="admin-input" type="time" name="exception_close" value={exception.close} /></label>
        </div>
        {exceptionErrors.hours && <p class="admin-error">{exceptionErrors.hours}</p>}
        {(["note_sv", "note_en"] as const).map((name) => (
          <label class="block space-y-1"><span class="font-medium block">{t(locale, name === "note_sv" ? "admin.hours.noteSv" : "admin.hours.noteEn")}</span>
            <input class="admin-input" name={name} id={name} value={exception[name]} maxlength="300" aria-invalid={exceptionErrors[name] ? "true" : undefined} />
            {exceptionErrors[name] && <span class="admin-error block">{exceptionErrors[name]}</span>}
          </label>
        ))}
        <button class="admin-button" type="submit">{t(locale, "admin.hours.addException")}</button>
      </form>
    </section>
  </section>
</AdminLayout>
