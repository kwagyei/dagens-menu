---
import Base from "../layouts/Base.astro";
import BookingWidget from "../components/BookingWidget.astro";
import PageHero from "../components/PageHero.astro";
import { getLocale, t } from "../i18n";

const locale = getLocale(Astro.url);
const settings = Astro.locals.content.settings;
// "Choose a date and time" only makes sense when a booking system is connected.
const intro = settings.booking.provider === "none" ? undefined : t(locale, "book.intro");
---

<Base title={t(locale, "book.heading")}>
  <PageHero title={t(locale, "book.heading")} intro={intro} />
  <section class="band book-band">
    <BookingWidget />
  </section>
</Base>
