---
import Base from "../layouts/Base.astro";
import BookingCta from "../components/BookingCta.astro";
import PageHero from "../components/PageHero.astro";
import { localized } from "../content/load";
import { getLocale, t } from "../i18n";

const locale = getLocale(Astro.url);
const { gallery, images } = Astro.locals.content;
// Alt text lives on the library image (ADR-014 §1); the schema guarantees a gallery photo has one.
const altOf = new Map(images.map((i) => [i.ref, i.alt]));
const photos = gallery.images.map((g) => ({ src: g.image, alt: altOf.get(g.image) }));
---

<Base title={t(locale, "nav.gallery")}>
  <PageHero title={t(locale, "nav.gallery")} />
  {photos.length > 0 ? (
    <ul class="gallery-magazine">
      {photos.map((image, i) => (
        <li>
          <figure>
            <img src={image.src} alt={image.alt ? localized(image.alt, locale) : t(locale, "gallery.alt.missing")} loading={i < 4 ? "eager" : "lazy"} />
          </figure>
        </li>
      ))}
    </ul>
  ) : (
    <p class="band">{t(locale, "gallery.empty")}</p>
  )}
  <BookingCta />
</Base>
