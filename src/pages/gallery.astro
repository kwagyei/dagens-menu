---
import Base from "../layouts/Base.astro";
import BookingCta from "../components/BookingCta.astro";
import PageHero from "../components/PageHero.astro";
import { localized } from "../content/load";
import { getLocale, t } from "../i18n";

const locale = getLocale(Astro.url);
const gallery = Astro.locals.content.gallery;
---

<Base title={t(locale, "nav.gallery")}>
  <PageHero title={t(locale, "nav.gallery")} />
  {gallery.images.length > 0 ? (
    <ul class="gallery-magazine">
      {gallery.images.map((image, i) => (
        <li>
          <figure>
            <img src={image.src} alt={localized(image.alt, locale)} loading={i < 4 ? "eager" : "lazy"} />
          </figure>
        </li>
      ))}
    </ul>
  ) : (
    <p class="band">{t(locale, "gallery.empty")}</p>
  )}
  <BookingCta />
</Base>
