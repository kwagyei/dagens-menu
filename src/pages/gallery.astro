---
import Photo from "../components/Photo.astro";
import Base from "../layouts/Base.astro";
import BookingCta from "../components/BookingCta.astro";
import PageHero from "../components/PageHero.astro";
import { getLocale, t } from "../i18n";

const locale = getLocale(Astro.url);
// Alt text and sizes come from the library image (ADR-014 §1, ADR-015 §4), through Photo.
const photos = Astro.locals.content.gallery.images;
---

<Base title={t(locale, "nav.gallery")}>
  <PageHero title={t(locale, "nav.gallery")} />
  {photos.length > 0 ? (
    <ul class="gallery-magazine">
      {photos.map((image, i) => (
        <li>
          <figure>
            <Photo ref={image.image} slot={i === 0 || i === 3 ? "galleryWide" : "gallery"} first={i === 0} />
          </figure>
        </li>
      ))}
    </ul>
  ) : (
    <p class="band">{t(locale, "gallery.empty")}</p>
  )}
  <BookingCta />
</Base>
