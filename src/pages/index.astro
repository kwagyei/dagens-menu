---
import Base from "../layouts/Base.astro";
import { getSettings, getPages, getMenu, getHours, localized, formatPrice, resolveHighlights, getTodayHours } from "../content/load";
import { getLocale, t, localePath } from "../i18n";

const locale = getLocale(Astro.url);
const settings = getSettings();
const pages = getPages();
const menu = getMenu();
const hours = getHours();
const tagline = localized(pages.home.tagline, locale);
const siteName = localized(settings.name, locale);
const cuisine = localized(settings.cuisine, locale);
const highlightIds = pages.home.highlights;
const highlights = resolveHighlights(menu, highlightIds);
const highlightImages = pages.home.highlightImages ?? {};
const todayHours = getTodayHours(hours);
---

<Base title={siteName} description={tagline}>

  <!-- Hero section — full-bleed dark with image -->
  <section class="relative overflow-hidden" style="background-color: var(--color-hero-bg);">
    {pages.home.heroImage && (
      <img
        src={pages.home.heroImage}
        alt=""
        class="absolute inset-0 w-full h-full object-cover"
        loading="eager"
      />
    )}
    <div class="absolute inset-0 img-overlay-dark"></div>

    <!-- Ghost watermark text -->
    <div class="ghost-text top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2">
      {cuisine}
    </div>

    <div class="section-container relative py-24 md:py-32 lg:py-40 text-center" style="z-index: 1;">
      <p class="font-display text-base md:text-lg tracking-widest mb-6" style="color: var(--color-hero-muted);">
        {cuisine}
      </p>
      <h1 class="font-display text-5xl sm:text-6xl md:text-7xl lg:text-8xl mb-6" style="color: var(--color-hero-text);">
        {siteName}
      </h1>
      <p class="font-heading text-lg md:text-xl max-w-xl mx-auto mb-10" style="color: var(--color-hero-muted);">
        {tagline}
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href={localePath(locale, "/book/")} class="btn btn-primary-on-dark">
          {t(locale, "home.book")}
        </a>

        <div class="hours-badge">
          {todayHours ? (
            <span>{t(locale, "hours.today")}: {todayHours.open}&ndash;{todayHours.close}</span>
          ) : (
            <span>{t(locale, "hours.today")}: {t(locale, "hours.closed")}</span>
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- Highlights — dark background, large alternating image/text blocks -->
  {highlights.length > 0 && (
    <section class="section-dark relative overflow-hidden">
      <div class="ghost-text top-8 left-1/2 -translate-x-1/2" style="font-size: clamp(4rem, 12vw, 10rem);">
        {t(locale, "nav.menu")}
      </div>

      <div class="section-container py-16 md:py-24 relative" style="z-index: 1;">
        <div class="text-center mb-12 md:mb-16">
          <h2 class="font-display text-3xl md:text-4xl lg:text-5xl mb-3" style="color: var(--color-hero-text);">
            {t(locale, "home.highlights")}
          </h2>
          <div class="divider-squiggle mx-auto mt-4 mb-4"></div>
          <a href={localePath(locale, "/menu/")} class="text-sm font-heading font-medium underline" style="color: var(--color-secondary);">
            {t(locale, "nav.menu")} &rarr;
          </a>
        </div>

        <div class="space-y-12 md:space-y-16 max-w-5xl mx-auto">
          {highlights.map((item, i) => {
            const imgSrc = highlightImages[highlightIds[i]];
            const isEven = i % 2 === 0;
            return (
              <div class={`flex flex-col ${isEven ? 'md:flex-row' : 'md:flex-row-reverse'} gap-6 md:gap-10 items-center`}>
                <div class="w-full md:w-1/2">
                  {imgSrc ? (
                    <img
                      src={imgSrc}
                      alt={localized(item.name, locale)}
                      class="w-full aspect-[4/3] object-cover rounded-lg shadow-2xl"
                      style={`border-radius: var(--radius);`}
                      loading="lazy"
                    />
                  ) : (
                    <div class="w-full aspect-[4/3] rounded-lg" style={`background: rgba(255,255,255,0.08); border-radius: var(--radius);`}></div>
                  )}
                </div>
                <div class={`w-full md:w-1/2 ${isEven ? 'md:pl-4' : 'md:pr-4'}`}>
                  <h3 class="font-display text-2xl md:text-3xl lg:text-4xl mb-3" style="color: var(--color-secondary);">
                    {localized(item.name, locale)}
                  </h3>
                  <p class="text-base leading-relaxed mb-4 font-heading" style="color: var(--color-hero-muted);">
                    {localized(item.description, locale)}
                  </p>
                  <p class="font-display text-2xl md:text-3xl" style="color: var(--color-hero-text);">
                    {formatPrice(item.price)}
                  </p>
                </div>
              </div>
            );
          })}
        </div>

        <div class="text-center mt-12">
          <a href={localePath(locale, "/menu/")} class="btn btn-primary-on-dark">
            {t(locale, "nav.menu")} &rarr;
          </a>
        </div>
      </div>
    </section>
  )}

  <!-- CTA band — dark section for contrast -->
  <section class="section-dark relative overflow-hidden">
    <div class="ghost-text top-1/2 right-0 translate-x-1/4 -translate-y-1/2" style="font-size: clamp(4rem, 10vw, 10rem);">
      {t(locale, "cta.booknow" as any)}
    </div>
    <div class="section-container py-16 md:py-24 text-center relative" style="z-index: 1;">
      <h2 class="font-display text-3xl md:text-4xl lg:text-5xl mb-4" style="color: var(--color-hero-text);">
        {t(locale, "cta.visit" as any)}
      </h2>
      <p class="text-base mb-8 max-w-md mx-auto" style="color: var(--color-hero-muted);">
        {localized(settings.tagline, locale)}
      </p>
      <a href={localePath(locale, "/book/")} class="btn btn-primary-on-dark">
        {t(locale, "home.book")}
      </a>
    </div>
  </section>

</Base>
