---
import Base from "../layouts/Base.astro";
import { getSettings, getPages, getMenu, getHours, localized, formatPrice, resolveHighlights, getTodayHours } from "../content/load";
import { getLocale, t, localePath } from "../i18n";

const locale = getLocale(Astro.url);
const settings = getSettings();
const pages = getPages();
const menu = getMenu();
const hours = getHours();
const tagline = localized(pages.home.tagline, locale);
const siteName = localized(settings.name, locale);
const highlights = resolveHighlights(menu, pages.home.highlights);
const todayHours = getTodayHours(hours);
---

<Base title={siteName} description={tagline}>
  <section class="py-12 text-center">
    <h1 class="text-4xl md:text-5xl font-bold" style={`font-family: var(--font-heading); color: var(--color-primary);`}>
      {siteName}
    </h1>
    <p class="mt-4 text-lg md:text-xl" style={`color: var(--color-text-muted);`}>
      {tagline}
    </p>

    <div class="mt-6 flex flex-col sm:flex-row items-center justify-center gap-4">
      {todayHours ? (
        <p class="text-sm" style="color: var(--color-text-muted);">
          {t(locale, "hours.today")}: {todayHours.open}&ndash;{todayHours.close}
        </p>
      ) : (
        <p class="text-sm" style="color: var(--color-text-muted);">
          {t(locale, "hours.today")}: {t(locale, "hours.closed")}
        </p>
      )}
      <a
        href={localePath(locale, "/book/")}
        class="inline-block px-6 py-3 text-sm font-bold rounded-lg"
        style={`background-color: var(--color-primary); color: var(--color-surface); border-radius: var(--radius);`}
      >
        {t(locale, "home.book")}
      </a>
    </div>
  </section>

  {highlights.length > 0 && (
    <section class="py-8">
      <h2 class="text-2xl font-bold mb-6 text-center" style={`font-family: var(--font-heading); color: var(--color-primary);`}>
        {t(locale, "home.highlights")}
      </h2>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {highlights.map((item) => (
          <div class="p-6 text-center" style={`background-color: var(--color-surface); border-radius: var(--radius);`}>
            <h3 class="font-bold text-lg">{localized(item.name, locale)}</h3>
            <p class="mt-2 text-sm" style="color: var(--color-text-muted);">
              {localized(item.description, locale)}
            </p>
            <p class="mt-3 font-bold" style="color: var(--color-primary);">
              {formatPrice(item.price)}
            </p>
          </div>
        ))}
      </div>
      <div class="mt-6 text-center">
        <a href={localePath(locale, "/menu/")} class="text-sm underline" style="color: var(--color-primary);">
          {t(locale, "nav.menu")} &rarr;
        </a>
      </div>
    </section>
  )}
</Base>
