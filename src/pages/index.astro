---
import Photo from "../components/Photo.astro";
import { cssUrl, photoSources } from "../content/images";
/**
 * Home. One booking button, in the hero, next to today's hours. The navigation sits on the hero
 * photo, so the layout leaves out the header (`bare`).
 *
 * Classic: full-bleed photo, the town, then the name in the display serif under the arc, a
 * swipe strip of the highlighted dishes, the owner's own line, and the lunch list when the menu has one.
 * Modern (laid out after a restaurant template's home page, see the README): the name as one huge word biting into a rounded photo, the
 * orange oval under it, then the tagline as a headline with the dish in stacked slices between
 * the week's hours and how to find the restaurant, then the highlights as cards.
 */
import Base from "../layouts/Base.astro";
import HomeStory from "../components/HomeStory.astro";
import Horizon from "../components/Horizon.astro";
import Squiggle from "../components/Squiggle.astro";
import MenuRow from "../components/MenuRow.astro";
import SiteNav from "../components/SiteNav.astro";
import { formatPrice, localized, resolveHighlights } from "../content/load";
import { dayAndMonth, runLabel, upcomingExceptions, weekRuns } from "../content/hours";
import { localityOf } from "../content/locality";
import { getLocale, localePath, t } from "../i18n";

const locale = getLocale(Astro.url);
const { settings, pages, menu, theme } = Astro.locals.content;
const today = Astro.locals.today;
const siteName = localized(settings.name, locale);
const tagline = localized(pages.home.tagline, locale);
const voice = pages.home.pullQuote ? localized(pages.home.pullQuote, locale) : null;
const highlights = resolveHighlights(menu, pages.home.highlights, today.soldOut);
// Modern: the week as runs of days with the same hours ("Tisdag–torsdag 12:00–22:00").
const runs = weekRuns(Astro.locals.content.hours.weekly);
// The next special day (a holiday closure, say), so the column doesn't promise the usual hours.
const nextException = upcomingExceptions(Astro.locals.content.hours, today.date)[0];
// The town above the classic hero's name, from the address ("Stockholm").
const locality = localityOf(settings.address);
const todayText = `${t(locale, "hours.today")}: ${today.hours ? `${today.hours.open}–${today.hours.close}` : t(locale, "hours.closed")}`;

// The hero photo sits behind the name and the booking button: decorative (alt="", ADR-015 §4).
const heroImage = pages.home.heroImage;
// The stacked slices draw this photo as a CSS background three times, so it takes one fixed size:
// they are at most 24rem wide (site.css), so 1200 px covers 2x screens with room to spare.
const ctaImage = pages.home.ctaImage ? Astro.locals.content.images.find((i) => i.ref === pages.home.ctaImage) : undefined;
const ctaSizes = ctaImage ? photoSources(ctaImage)?.sizes : undefined;
const ctaUrl = cssUrl(ctaSizes ? (ctaSizes.find((s) => s.width >= 1200) ?? ctaSizes[ctaSizes.length - 1]).url : (ctaImage?.ref ?? pages.home.ctaImage));

// Classic shows the lunch list when the menu has a lunch category with something on sale.
const soldOut = new Set(today.soldOut);
const lunch = menu.categories.find((c) => c.id === "lunch");
const lunchItems = lunch ? lunch.items.filter((item) => item.available && !soldOut.has(item.id)) : [];

// Modern sets the name as two lines, each stretched to the full width (SVG textLength), with the
// shorter line set larger so both stretch by a similar amount. Anton's capitals average about
// 0.55 em wide, so a line of n letters needs about 100 / (0.55 n) units to fill 100.
const words = siteName.toUpperCase().split(/\s+/).filter(Boolean);
const lines = words.length === 2 ? words : [words.join(" ")];
let y = 0;
const wordLines = lines.map((text) => {
  const size = Math.min(60, Math.max(14, 100 / (0.55 * [...text].length)));
  y += size * (y === 0 ? 0.87 : 0.95);
  return { text, size: Math.round(size * 10) / 10, y: Math.round(y * 10) / 10 };
});
const wordHeight = Math.ceil(y + 1);
// On a wide screen the name is one line across the photo's full width (as in the reference),
// pulled up so its top part overlaps the photo.
const oneLine = words.join(" ");
const oneLineSize = Math.round(Math.min(60, Math.max(10, 100 / (0.55 * [...oneLine].length))) * 10) / 10;
const oneLineY = Math.round(oneLineSize * 0.87 * 10) / 10;
const oneLineHeight = Math.ceil(oneLineY + 1);
---

<Base title={siteName} description={tagline} bare>
  {theme.style === "classic" ? (
    <>
      <section class="hero-ljus" aria-labelledby="page-title">
        <Photo ref={heroImage} slot="hero" class="hero-ljus__img" first />
        <div class="hero-ljus__nav">
          <SiteNav variant="hero" />
        </div>
        <svg class="arc" viewBox="0 0 360 120" aria-hidden="true" focusable="false">
          <path d="M8 112 Q180 -22 352 112" fill="none" stroke="currentColor" stroke-width="1.5" />
          <circle cx="70" cy="72" r="7" fill="currentColor" />
        </svg>
        {locality && <p class="hero-ljus__eyebrow">{locality}</p>}
        <h1 id="page-title">{siteName}</h1>
        <p class="hero-ljus__tagline">{tagline}</p>
        <a class="btn btn-light" href={localePath(locale, "/book/")}>
          {t(locale, "home.book")}
        </a>
        <p class="hours-badge">{todayText}</p>
      </section>

      {highlights.length > 0 && (
        <section class="taste" aria-labelledby="taste-title">
          <div class="taste__head">
            <h2 class="stag" id="taste-title">
              <span>{t(locale, "home.taste.1")}</span>
              <span class="stag__two">{t(locale, "home.taste.2")}</span>
            </h2>
          </div>
          <ul class="strip" style={`--n: ${highlights.length}`} tabindex="0" aria-label={t(locale, "home.dishes")}>
            {highlights.map(({ item }) => (
              <li>
                <figure class:list={{ strip__plain: !item.image }}>
                  <Photo ref={item.image} slot="strip" />
                  <figcaption>
                    {localized(item.name, locale)}
                    <span>{formatPrice(item.price)}</span>
                  </figcaption>
                </figure>
              </li>
            ))}
          </ul>
          {highlights.length > 1 && <p class="swipe-hint narrow-only">{t(locale, "home.swipe")}</p>}
        </section>
      )}

      <section class="home-intro" aria-label={t(locale, "nav.menu")}>
        {voice && <p class="home-intro__voice">{voice}</p>}
        <a class="btn btn-primary" href={localePath(locale, "/menu/")}>
          {t(locale, "home.fullMenu")}
        </a>
      </section>

      <HomeStory />

      {lunch && lunchItems.length > 0 && (
        <section class="home-lunch wood" aria-labelledby="lunch-title">
          <div class="home-lunch__card linen">
            <Horizon />
            <h2 class="section-title" id="lunch-title">
              {localized(lunch.name, locale)}
            </h2>
            <ul class="plain home-lunch__list">
              {lunchItems.map((item) => (
                <MenuRow item={item} brief />
              ))}
            </ul>
          </div>
        </section>
      )}
    </>
  ) : (
    <>
      <section class="hero-dag" aria-labelledby="page-title">
        <div class="hero-dag__photo">
          {heroImage ? <Photo ref={heroImage} slot="hero" class="hero-dag__img" first /> : <div class="hero-dag__img" />}
          <div class="hero-dag__nav">
            <SiteNav variant="hero" />
          </div>
        </div>
        <h1 class="hero-dag__word" id="page-title">
          <svg class="narrow-only" viewBox={`0 0 100 ${wordHeight}`} role="img" aria-label={siteName}>
            {wordLines.map((line) => (
              <text x="0" y={line.y} font-size={line.size} textLength="100" lengthAdjust="spacingAndGlyphs">
                {line.text}
              </text>
            ))}
          </svg>
          <svg class="wide-only" viewBox={`0 0 100 ${oneLineHeight}`} role="img" aria-label={siteName}>
            <text x="0" y={oneLineY} font-size={oneLineSize} textLength="100" lengthAdjust="spacingAndGlyphs">
              {oneLine}
            </text>
          </svg>
        </h1>
        <a class="btn btn-primary pill" href={localePath(locale, "/book/")}>
          {t(locale, "home.book")}
        </a>
      </section>

      <section class="intro-dag" aria-labelledby="intro-title">
        <Squiggle />
        <h2 class="intro-dag__title" id="intro-title">
          {tagline}
        </h2>
        {voice && <p class="intro-dag__voice">{voice}</p>}
        <div class:list={["intro-dag__feature", { "intro-dag__feature--photo": ctaUrl }]}>
          {ctaUrl && (
            <div class="slices">
              <i style={`background-image: ${ctaUrl}`}></i>
              <i style={`background-image: ${ctaUrl}`}></i>
              <i style={`background-image: ${ctaUrl}`}></i>
              <a class="star" href={localePath(locale, "/menu/")}>
                {t(locale, "home.seeMenu")}
              </a>
            </div>
          )}
          <div class="intro-dag__hours">
            <h3>{t(locale, "home.hours")}</h3>
            <dl>
              {runs.map((run) => (
                <div>
                  <dt>{runLabel(run, locale)}</dt>
                  <dd>{run.hours ? `${run.hours.open}–${run.hours.close}` : t(locale, "hours.closed")}</dd>
                </div>
              ))}
            </dl>
            {nextException && (
              <p class="intro-dag__exception">
                {t(locale, "hours.exception")}: <time datetime={nextException.date}>{dayAndMonth(nextException.date, locale)}</time>, {localized(nextException.note, locale)} (
                {nextException.hours ? `${nextException.hours.open}–${nextException.hours.close}` : t(locale, "hours.closed")})
              </p>
            )}
            <p class="hours-badge">{todayText}</p>
          </div>
          <div class="intro-dag__find">
            <h3>{t(locale, "home.findUs")}</h3>
            <address>
              <span>{settings.address}</span>
              <a href={`tel:${settings.phone.replace(/[\s-]/g, "")}`}>{settings.phone}</a>
              <a href={`mailto:${settings.email}`}>{settings.email}</a>
            </address>
          </div>
        </div>
      </section>

      {highlights.length > 0 && (
        <section class="home-dishes" aria-labelledby="dishes-title">
          <div class="home-dishes__head">
            <h2 class="section-title" id="dishes-title">
              {t(locale, "home.fromKitchen")}
            </h2>
            <a class="link-strong" href={localePath(locale, "/menu/")}>
              {t(locale, "home.fullMenu")}
            </a>
          </div>
          <ul class="dish-cards">
            {highlights.map(({ item }) => (
              <li>
                <figure class="dish-card">
                  {item.image ? <Photo ref={item.image} slot="card" /> : <div class="dish-card__plain" />}
                  <figcaption>
                    <span>{localized(item.name, locale)}</span>
                    <span class="dish-card__price">{formatPrice(item.price)}</span>
                  </figcaption>
                </figure>
              </li>
            ))}
          </ul>
        </section>
      )}

      <HomeStory />
    </>
  )}
</Base>
