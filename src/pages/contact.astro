---
import Base from "../layouts/Base.astro";
import HoursTable from "../components/HoursTable.astro";
import MapEmbed from "../components/MapEmbed.astro";
import { getSettings, getHours } from "../content/load";
import { getLocale, t } from "../i18n";

const locale = getLocale(Astro.url);
const settings = getSettings();
const hours = getHours();
---

<Base title={t(locale, "nav.contact")}>
  <h1 class="text-3xl font-bold mb-8" style={`font-family: var(--font-heading); color: var(--color-primary);`}>
    {t(locale, "nav.contact")}
  </h1>

  <div class="grid gap-8 md:grid-cols-2">
    <div class="space-y-6">
      <div>
        <h2 class="font-bold mb-1">{t(locale, "contact.address")}</h2>
        <p>{settings.address}</p>
      </div>
      <div>
        <h2 class="font-bold mb-1">{t(locale, "contact.phone")}</h2>
        <a href={`tel:${settings.phone}`} class="underline" style="color: var(--color-primary);">
          {settings.phone}
        </a>
      </div>
      <div>
        <h2 class="font-bold mb-1">{t(locale, "contact.email")}</h2>
        <a href={`mailto:${settings.email}`} class="underline" style="color: var(--color-primary);">
          {settings.email}
        </a>
      </div>

      <MapEmbed />
    </div>

    <div class="p-6" style={`background-color: var(--color-surface); border-radius: var(--radius);`}>
      <h2 class="text-xl font-bold mb-4" style="font-family: var(--font-heading);">
        {t(locale, "contact.hours")}
      </h2>
      <HoursTable hours={hours} />
    </div>
  </div>
</Base>
