// The bistro demo's Worker (ADR-011). The Astro adapter fills in main and assets at build time.
// SITE_ID must equal the SITE the build was made for: the theme and curated images are built
// in, the content comes from D1 for this site id.
{
  "name": "dagens-menu-bistro",
  // No preview URLs: an uploaded but untested version must never answer on a public URL
  // against the production database (security review L3, 18 Oct).
  "preview_urls": false,
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": { "SITE_ID": "bistro" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dagens-menu",
      // The production database. Local development (wrangler dev, astro dev) uses a local
      // copy in .wrangler/state instead; seed it with npm run seed.
      "database_id": "df3dcc91-ea36-4834-ae85-6ebc1ba12b2e",
      "migrations_dir": "migrations"
    }
  ],
  // Opening invite links and the passkey ceremonies (enrolment, sign-in, adding a device):
  // 10 per minute per site and IP, counted per Cloudflare location (ADR-011 §6). Other admin
  // writes are not limited. Without this binding those paths answer 503 (src/auth/guard.ts).
  "ratelimits": [{ "name": "AUTH_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }],
  "observability": { "enabled": true }
}
