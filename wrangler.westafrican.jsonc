// The westafrican demo's Worker (ADR-011). The Astro adapter fills in main and assets at build time.
// SITE_ID must equal the SITE the build was made for: the theme and curated images are built
// in, the content comes from D1 for this site id.
{
  "name": "dagens-menu-westafrican",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": { "SITE_ID": "westafrican" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dagens-menu",
      // Placeholder until the production database exists (ADR-011 plan M3.7). Local
      // development uses .wrangler/state, shared with d1.local.jsonc through this id.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true }
}
