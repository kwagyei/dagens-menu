// Local development database for the seed CLI and `npm run db:migrate:local`. The id is a
// placeholder: local D1 lives in .wrangler/state. The deployed Workers get their own config
// with the real database id (ADR-011 M3).
{
  "name": "dagens-menu-local",
  "compatibility_date": "2026-10-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dagens-menu",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
