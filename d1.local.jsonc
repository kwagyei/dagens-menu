// Local development database for the seed CLI and `npm run db:migrate:local`. It names the
// production database's id so that local tools and `wrangler dev` share one local copy in
// .wrangler/state; nothing here touches the real database unless --remote is passed.
{
  "name": "dagens-menu-local",
  "compatibility_date": "2026-10-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dagens-menu",
      "database_id": "df3dcc91-ea36-4834-ae85-6ebc1ba12b2e",
      "migrations_dir": "migrations"
    }
  ]
}
